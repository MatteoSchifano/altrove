---
/* ─────────────────────────────────────────────────────────────
   DropCapQuote — la citazione celebrativa, col capolettera.

   Il capolettera (drop cap) è il gesto editoriale più antico: la
   prima lettera ingrandita che “affonda” di alcune righe e segna
   un inizio solenne. È il modo di dare a una citazione un peso da
   apertura di capitolo, senza dire una parola in più.

   La tecnica onesta sta nel grado di supporto:
     • initial-letter — la proprietà GIUSTA: dice “questa lettera
       vale N righe” e il browser calcola da solo l’affondamento e
       l’allineamento alla baseline. Supporto reale: Safari, e
       Chrome dietro flag/parziale.
     • ::first-letter con float — il FALLBACK che funziona ovunque:
       float left + font-size grande. Meno preciso (la baseline non
       si allinea perfetta) ma robusto.
   Diamo entrambi: dove initial-letter è supportata, vince; altrove,
   il float regge la scena. È miglioramento progressivo, non una
   promessa che il browser non può mantenere.

   Resta una <blockquote> vera: è parola di un altro, con la sua
   fonte in <cite>. Il capolettera è vestito, non semantica — per
   questo è aria-hidden a livello visivo ma la lettera è nel testo,
   quindi lo screen reader legge la parola intera, non “M” + “entre”.

   Niente motion: una citazione celebrativa si presenta ferma.
   ───────────────────────────────────────────────────────────── */

interface Props {
  locale?: 'it' | 'en';
}
const { locale = 'it' } = Astro.props;

const COPY = {
  it: {
    quote: 'Mentre l’interfaccia lavora in silenzio, l’utente è libero di essere altrove con la mente: è lì, in quell’assenza di attrito, che vive la cura.',
    person: 'Altrove',
    work: 'Capitolo zero',
  },
  en: {
    quote: 'While the interface works in silence, the user is free to be elsewhere in their mind: there, in that absence of friction, is where the craft lives.',
    person: 'Altrove',
    work: 'Chapter zero',
  },
} as const;
const c = COPY[locale];
---

<figure class="dcq" lang={locale}>
  <blockquote class="dcq__quote">
    <p class="dcq__text">{c.quote}</p>
  </blockquote>
  <figcaption class="dcq__attr">
    <span aria-hidden="true">—&nbsp;</span><cite class="dcq__work">{c.work}</cite>,
    {c.person}
  </figcaption>
</figure>

<style>
  .dcq {
    inline-size: min(32rem, 100%);
    margin: 0;
  }

  .dcq__quote { margin: 0; }

  .dcq__text {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    letter-spacing: var(--tracking-snug);
    color: var(--ink-strong);
    text-wrap: pretty;
  }

  /* Fallback universale: float + scala. La lettera affonda “a
     occhio” su 3 righe. Funziona in ogni browser. */
  .dcq__text::first-letter {
    float: inline-start;
    font-size: 3.1em;
    line-height: 0.82;
    font-weight: var(--weight-bold);
    color: var(--accent);
    padding-inline-end: 0.08em;
    margin-block-start: 0.04em;
  }

  /* Progressive enhancement: dove initial-letter è supportata,
     il browser calcola un affondamento PRECISO su 3 righe e
     allinea alla baseline. Spegne il float del fallback. */
  @supports (initial-letter: 3) or (-webkit-initial-letter: 3) {
    .dcq__text::first-letter {
      float: none;
      font-size: inherit;
      line-height: inherit;
      -webkit-initial-letter: 3;
      initial-letter: 3;
      margin-inline-end: 0.1em;
    }
  }

  .dcq__attr {
    margin-block-start: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .dcq__work {
    font-style: italic;
    color: var(--ink);
  }

  .dcq__text::selection { background-color: var(--accent-soft); }
  .dcq__text::first-letter::selection { background-color: var(--accent-soft); }
</style>
