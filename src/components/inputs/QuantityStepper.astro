---
/* ─────────────────────────────────────────────────────────────
   QuantityStepper — il numero come quantità.

   Un input "quantità" non è un campo di testo qualsiasi: è una
   piccola macchina. Ha un minimo, un massimo, e un passo. Per
   modificarlo l'utente può:
     • digitare (con inputmode="numeric" la tastiera mobile è
       quella corretta);
     • cliccare i pulsanti −/+ ai lati;
     • usare le frecce su/giù della tastiera.

   La cifra al centro usa font-variant-numeric: tabular-nums
   perché passando da "9" a "10" non vogliamo che il layout
   tremi (richiamo del cap. 06).

   I limiti si rispettano "morbidamente": il bottone si disabilita
   al raggiungimento dell'estremo, non blocca l'utente con un alert.

   Reduced motion: nessuna animazione di press sui bottoni.
   ───────────────────────────────────────────────────────────── */

interface Props {
  initial?: number;
  min?: number;
  max?: number;
  label?: string;
  id?: string;
}

const {
  initial = 2,
  min = 0,
  max = 20,
  label = 'Quantità · invitati al tavolo',
  id = 'qty-guests',
} = Astro.props;
---

<div class="qty">
  <label class="qty__label" for={id}>{label}</label>
  <div class="qty__group" role="group" aria-labelledby={`${id}-label`}>
    <button
      type="button"
      class="qty__btn"
      data-step="-1"
      aria-label="Diminuisci di uno"
    >
      <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <path d="M3.5 8h9" />
      </svg>
    </button>
    <input
      id={id}
      class="qty__input tabular"
      type="text"
      inputmode="numeric"
      pattern="[0-9]*"
      value={String(initial)}
      data-min={String(min)}
      data-max={String(max)}
      aria-live="polite"
    />
    <button
      type="button"
      class="qty__btn"
      data-step="1"
      aria-label="Aumenta di uno"
    >
      <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <path d="M8 3.5v9M3.5 8h9" />
      </svg>
    </button>
  </div>
  <p class="qty__hint">
    <span class="tabular">min {min} · max {max}</span> — frecce ↑↓ per regolare da tastiera.
  </p>
</div>

<style>
  .qty {
    inline-size: min(22rem, 100%);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .qty__label {
    font-size: var(--text-sm);
    color: var(--ink-strong);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
  }

  .qty__group {
    display: inline-grid;
    grid-template-columns: auto 1fr auto;
    align-items: stretch;
    border-radius: var(--radius-md);
    background-color: var(--surface-raised);
    border: 1px solid var(--border);
    overflow: hidden;
    transition:
      border-color var(--dur-fast) var(--ease-out-soft),
      box-shadow var(--dur-fast) var(--ease-out-soft);
  }

  .qty__group:focus-within {
    border-color: var(--accent);
    box-shadow: var(--halo-focus);
  }

  .qty__btn {
    appearance: none;
    inline-size: 2.75rem;
    display: grid;
    place-items: center;
    background-color: transparent;
    border: 0;
    color: var(--ink-muted);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out-soft),
      color var(--dur-fast) var(--ease-out-soft);
  }

  .qty__btn:hover:not(:disabled) {
    background-color: color-mix(in oklab, var(--accent) 8%, transparent);
    color: var(--ink-strong);
  }

  .qty__btn:active:not(:disabled) {
    background-color: color-mix(in oklab, var(--accent) 14%, transparent);
  }

  .qty__btn:focus-visible {
    outline: none;
    background-color: color-mix(in oklab, var(--accent) 12%, transparent);
    color: var(--ink-strong);
  }

  .qty__btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .qty__btn svg {
    inline-size: 1rem;
    block-size: 1rem;
  }

  .qty__input {
    appearance: none;
    border: 0;
    background: transparent;
    text-align: center;
    font-family: inherit;
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    color: var(--ink-strong);
    inline-size: 100%;
    padding: 0.625rem 0.25rem;
    font-variant-numeric: tabular-nums;
    border-inline: 1px solid var(--border);
  }

  .qty__input:focus-visible {
    outline: none;
    background-color: color-mix(in oklab, var(--accent) 5%, transparent);
  }

  /* Nascondi le frecce native (le ricreiamo accessibili) */
  .qty__input::-webkit-outer-spin-button,
  .qty__input::-webkit-inner-spin-button {
    appearance: none;
    margin: 0;
  }

  .qty__hint {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }
</style>

<script>
  function clamp(v: number, min: number, max: number) {
    return Math.min(max, Math.max(min, v));
  }

  function bind() {
    document.querySelectorAll<HTMLElement>('.qty').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      const input = root.querySelector<HTMLInputElement>('.qty__input')!;
      const btns = root.querySelectorAll<HTMLButtonElement>('.qty__btn');
      const min = Number(input.dataset.min ?? 0);
      const max = Number(input.dataset.max ?? 99);

      const sync = () => {
        const v = Number(input.value || 0);
        btns.forEach((b) => {
          const step = Number(b.dataset.step ?? 0);
          b.disabled = (step < 0 && v <= min) || (step > 0 && v >= max);
        });
      };

      const set = (next: number) => {
        const c = clamp(Math.round(next), min, max);
        input.value = String(c);
        sync();
      };

      btns.forEach((b) => {
        const step = Number(b.dataset.step ?? 0);
        b.addEventListener('click', () => set(Number(input.value || 0) + step));
      });

      input.addEventListener('input', () => {
        // Pulisci a soli numeri mentre l'utente digita; non clampare
        // finché sta scrivendo per evitare di sovrascrivere "1" → "10".
        const cleaned = input.value.replace(/[^\d]/g, '');
        if (cleaned !== input.value) input.value = cleaned;
        sync();
      });

      input.addEventListener('blur', () => set(Number(input.value || min)));

      input.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowUp') {
          e.preventDefault();
          set(Number(input.value || 0) + 1);
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          set(Number(input.value || 0) - 1);
        }
      });

      sync();
    });
  }

  document.addEventListener('astro:page-load', bind);
</script>
