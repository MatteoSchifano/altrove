---
/* ─────────────────────────────────────────────────────────────
   PasswordReveal — la password e il suo velo.

   Due gesti che cambiano la qualità della compilazione:
     1. Un toggle reveal (occhio aperto/chiuso) che permette di
        rileggere ciò che si è scritto. Senza toggle, gli errori
        di digitazione si scoprono al primo tentativo di login.
        Il bottone è un <button type="button"> dentro al field e
        usa aria-pressed per dire lo stato a screen reader e
        utenti di sola tastiera.
     2. Una barra di forza che valuta la password mentre la si
        scrive. Quattro stati: debole, media, buona, forte. La
        soglia non è scolpita nella pietra — è euristica, e
        l'aria-live="polite" la rende leggibile senza spaventare.

   autocomplete="new-password" dice al browser/password manager
   di non riempire con una password esistente ma di proporre la
   generazione di una nuova. È l'attributo giusto per i form di
   registrazione e cambio password.

   Reduced motion: la barra cresce senza transizione, l'icona
   non ruota — solo lo swap del glifo.
   ───────────────────────────────────────────────────────────── */
---

<div class="pw">
  <label class="pw__label" for="pw-input">Nuova password</label>
  <div class="pw__wrap">
    <input
      id="pw-input"
      class="pw__input"
      type="password"
      name="new-password"
      autocomplete="new-password"
      placeholder="almeno 8 caratteri"
      aria-describedby="pw-strength"
    />
    <button
      type="button"
      class="pw__toggle"
      aria-pressed="false"
      aria-label="Mostra la password"
    >
      <svg class="pw__eye pw__eye--closed" viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 10s2.5-5 7-5 7 5 7 5-2.5 5-7 5-7-5-7-5Z" />
        <circle cx="10" cy="10" r="2" />
        <path d="M3 17 17 3" />
      </svg>
      <svg class="pw__eye pw__eye--open" viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 10s2.5-5 7-5 7 5 7 5-2.5 5-7 5-7-5-7-5Z" />
        <circle cx="10" cy="10" r="2" />
      </svg>
    </button>
  </div>
  <div class="pw__meter" aria-hidden="true">
    <span class="pw__bar" data-level="0"></span>
    <span class="pw__bar" data-level="0"></span>
    <span class="pw__bar" data-level="0"></span>
    <span class="pw__bar" data-level="0"></span>
  </div>
  <p class="pw__strength" id="pw-strength" aria-live="polite">
    Forza: <span class="pw__level">—</span>
  </p>
</div>

<style>
  .pw {
    inline-size: min(22rem, 100%);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pw__label {
    font-size: var(--text-sm);
    color: var(--ink-strong);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
  }

  .pw__wrap {
    position: relative;
    display: grid;
  }

  .pw__input {
    appearance: none;
    inline-size: 100%;
    padding: 0.75rem 2.875rem 0.75rem 1rem;
    border-radius: var(--radius-md);
    background-color: var(--surface-raised);
    border: 1px solid var(--border);
    color: var(--ink-strong);
    font-family: inherit;
    font-size: var(--text-base);
    transition:
      border-color var(--dur-fast) var(--ease-out-soft),
      box-shadow var(--dur-fast) var(--ease-out-soft);
  }

  .pw__input::placeholder { color: var(--ink-subtle); opacity: 1; }

  .pw__input:hover { border-color: var(--border-strong); }

  .pw__input:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: var(--halo-focus);
  }

  .pw__toggle {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0.25rem;
    inline-size: 2.5rem;
    display: grid;
    place-items: center;
    background: transparent;
    border: 0;
    border-radius: var(--radius-sm);
    color: var(--ink-muted);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out-soft);
  }

  .pw__toggle:hover { color: var(--ink-strong); }

  .pw__toggle:focus-visible {
    outline: none;
    color: var(--ink-strong);
    box-shadow: var(--halo-focus);
  }

  .pw__eye {
    grid-area: 1 / 1;
    inline-size: 1.125rem;
    block-size: 1.125rem;
  }

  .pw__toggle {
    display: grid;
  }

  .pw__eye--open { display: none; }
  .pw__toggle[aria-pressed='true'] .pw__eye--closed { display: none; }
  .pw__toggle[aria-pressed='true'] .pw__eye--open  { display: block; }

  .pw__meter {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.3125rem;
    margin-block-start: 0.25rem;
  }

  .pw__bar {
    block-size: 0.25rem;
    border-radius: var(--radius-pill);
    background-color: var(--border);
    transition: background-color var(--dur-normal) var(--ease-out-soft);
  }

  /* Livelli: 1=debole, 2=media, 3=buona, 4=forte */
  .pw__bar[data-level='1'] { background-color: oklch(0.65 0.18 28); }
  .pw__bar[data-level='2'] { background-color: oklch(0.74 0.14 60); }
  .pw__bar[data-level='3'] { background-color: oklch(0.72 0.16 105); }
  .pw__bar[data-level='4'] { background-color: oklch(0.62 0.16 145); }

  .pw__strength {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .pw__level { font-weight: var(--weight-medium); color: var(--ink); }
</style>

<script>
  type Strength = { score: 0 | 1 | 2 | 3 | 4; label: string };

  // Euristica leggera: lunghezza + classi di caratteri usate.
  // Non vuole essere zxcvbn — vuole essere onesta.
  function evaluate(value: string): Strength {
    if (!value) return { score: 0, label: '—' };

    let classes = 0;
    if (/[a-z]/.test(value)) classes++;
    if (/[A-Z]/.test(value)) classes++;
    if (/[0-9]/.test(value)) classes++;
    if (/[^A-Za-z0-9]/.test(value)) classes++;

    const len = value.length;

    let score: 0 | 1 | 2 | 3 | 4 = 0;
    if (len >= 4) score = 1;
    if (len >= 8 && classes >= 2) score = 2;
    if (len >= 10 && classes >= 3) score = 3;
    if (len >= 12 && classes >= 4) score = 4;

    const labels = ['—', 'debole', 'media', 'buona', 'forte'];
    return { score, label: labels[score] };
  }

  function bind() {
    document.querySelectorAll<HTMLElement>('.pw').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      const input = root.querySelector<HTMLInputElement>('.pw__input')!;
      const toggle = root.querySelector<HTMLButtonElement>('.pw__toggle')!;
      const bars = root.querySelectorAll<HTMLElement>('.pw__bar');
      const levelEl = root.querySelector<HTMLElement>('.pw__level')!;

      toggle.addEventListener('click', () => {
        const pressed = toggle.getAttribute('aria-pressed') === 'true';
        const next = !pressed;
        toggle.setAttribute('aria-pressed', String(next));
        toggle.setAttribute('aria-label', next ? 'Nascondi la password' : 'Mostra la password');
        input.type = next ? 'text' : 'password';
      });

      const refresh = () => {
        const { score, label } = evaluate(input.value);
        bars.forEach((b, i) => {
          b.dataset.level = i < score ? String(score) : '0';
        });
        levelEl.textContent = label;
      };

      input.addEventListener('input', refresh);
      refresh();
    });
  }

  document.addEventListener('astro:page-load', bind);
</script>
