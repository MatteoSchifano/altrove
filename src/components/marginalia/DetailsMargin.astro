---
/* ─────────────────────────────────────────────────────────────
   DetailsMargin — note a margine espandibili, fatte di <details>.

   La progressive disclosure onesta: non nascondi l’informazione per
   ingannare, la *offri ripiegata* perché non tutti la vogliono adesso.
   Il lettore vede un richiamo discreto a margine ("Approfondisci");
   se lo apre, la nota si dispiega in linea. Se non lo apre, il filo
   del testo resta pulito.

   Perché <details>/<summary> nativi e non un div + JS?
   - Lo stato aperto/chiuso è REALE: lo screen reader annuncia
     "comprimi/espandi", la tastiera (Invio/Spazio sul summary)
     funziona gratis, e il browser gestisce il focus.
   - È cercabile: "Trova nella pagina" apre i <details> che contengono
     il match (nei browser che supportano hidden=until-found). Una
     finta disclosure JS si perderebbe quel testo.
   - Funziona anche senza JS: è HTML che fa quello che promette.

   Il nostro unico tocco JS è il marker che ruota: ascoltiamo l’evento
   nativo "toggle" — non reinventiamo lo stato, lo riflettiamo. E se
   l’utente preferisce meno motion, il marker non ruota animando: si
   trova già nella posizione giusta (durata-token a 1ms).

   Accessibilità extra: il triangolo del marker NON è l’unico segnale —
   accanto c’è sempre la parola "Approfondisci"/"Chiudi", che cambia
   con lo stato.
   ───────────────────────────────────────────────────────────── */

interface Props {
  locale?: 'it' | 'en';
}
const { locale = 'it' } = Astro.props;

const COPY = {
  it: {
    body:
      'La gerarchia tipografica guida l’occhio prima ancora della lettura: dimensione, peso e spazio dicono "comincia da qui".',
    notes: [
      {
        summaryClosed: 'Approfondisci · gerarchia',
        summaryOpen: 'Chiudi',
        text:
          'La gerarchia non è solo grandezza. Tre titoli tutti grandi non hanno gerarchia: serve contrasto — uno grande, uno medio, uno piccolo — perché l’occhio capisca l’ordine.',
      },
      {
        summaryClosed: 'Approfondisci · spazio',
        summaryOpen: 'Chiudi',
        text:
          'Lo spazio bianco attorno a un elemento ne aumenta il peso percepito: isolare è enfatizzare. Spesso si ottiene più con il margine che con il grassetto.',
      },
    ],
  },
  en: {
    body:
      'Typographic hierarchy guides the eye before reading even begins: size, weight and space say "start here".',
    notes: [
      {
        summaryClosed: 'Read more · hierarchy',
        summaryOpen: 'Close',
        text:
          'Hierarchy isn’t just size. Three headings all large have no hierarchy: you need contrast — one large, one medium, one small — so the eye grasps the order.',
      },
      {
        summaryClosed: 'Read more · space',
        summaryOpen: 'Close',
        text:
          'White space around an element raises its perceived weight: to isolate is to emphasise. Often you achieve more with margin than with bold.',
      },
    ],
  },
} as const;
const c = COPY[locale];
---

<div class="dm">
  <p class="dm__body">{c.body}</p>

  <div class="dm__notes">
    {c.notes.map((n) => (
      <details class="dm__note" data-open={n.summaryOpen} data-closed={n.summaryClosed}>
        <summary class="dm__summary">
          <svg class="dm__marker" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 4l4 4-4 4" />
          </svg>
          <span class="dm__summary-label">{n.summaryClosed}</span>
        </summary>
        <p class="dm__note-text">{n.text}</p>
      </details>
    ))}
  </div>
</div>

<style>
  .dm {
    inline-size: min(36rem, 100%);
    container-type: inline-size;
    display: grid;
    gap: var(--space-md);
  }

  .dm__body {
    font-size: var(--text-base);
    color: var(--ink);
    line-height: var(--leading-loose);
    margin: 0;
    max-inline-size: 46ch;
  }

  .dm__notes {
    display: grid;
    gap: var(--space-2xs);
  }
  /* Largo: le note vivono in colonna a margine, accanto al testo. */
  @container (min-width: 32rem) {
    .dm { grid-template-columns: 1fr 13rem; align-items: start; }
    .dm__notes { grid-column: 2; }
  }

  .dm__note {
    border-radius: var(--radius-md);
    background-color: var(--surface-raised);
    border: 1px solid var(--border);
    border-inline-start: 2px solid var(--accent);
    overflow: hidden;
  }

  .dm__summary {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    padding: var(--space-2xs) var(--space-sm);
    cursor: pointer;
    list-style: none; /* via il marker nativo: lo disegniamo noi */
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--accent-ink);
    user-select: none;
  }
  .dm__summary::-webkit-details-marker { display: none; }
  .dm__summary:focus-visible {
    outline: none;
    box-shadow: var(--halo-focus);
    border-radius: var(--radius-sm);
  }
  .dm__summary:hover { background-color: var(--surface-sunken); }

  .dm__marker {
    inline-size: 0.85rem;
    block-size: 0.85rem;
    flex-shrink: 0;
    transition: transform var(--dur-fast) var(--ease-out-soft);
  }
  .dm__note[open] .dm__marker { transform: rotate(90deg); }

  .dm__note-text {
    margin: 0;
    padding: 0 var(--space-sm) var(--space-sm) calc(var(--space-sm) + 0.85rem + var(--space-3xs));
    font-size: var(--text-xs);
    color: var(--ink-muted);
    line-height: var(--leading-relaxed);
    max-inline-size: none;
  }
  /* L’apertura anima il contenuto in entrata, una volta sola.
     Sotto reduced motion la durata-token è 1ms: appare senza viaggio. */
  .dm__note[open] .dm__note-text {
    animation: dm-reveal var(--dur-normal) var(--ease-out-soft);
  }

  @keyframes dm-reveal {
    from { opacity: 0; transform: translateY(-0.25rem); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .dm__marker { transition: none; }
    .dm__note[open] .dm__note-text { animation: none; }
  }
</style>

<script>
  function bind() {
    document.querySelectorAll<HTMLDetailsElement>('.dm__note').forEach((note) => {
      if (note.dataset.bound === 'true') return;
      note.dataset.bound = 'true';

      const label = note.querySelector<HTMLElement>('.dm__summary-label');
      const closed = note.dataset.closed ?? '';
      const open = note.dataset.open ?? '';
      if (!label) return;

      // Non reinventiamo lo stato: ascoltiamo l’evento nativo "toggle"
      // e aggiorniamo solo l’etichetta testuale (secondo canale del marker).
      const onToggle = () => {
        label.textContent = note.open ? open : closed;
      };
      note.addEventListener('toggle', onToggle);

      note.addEventListener('astro:before-swap', () => {
        note.removeEventListener('toggle', onToggle);
      }, { once: true });
    });
  }

  document.addEventListener('astro:page-load', bind);
</script>
