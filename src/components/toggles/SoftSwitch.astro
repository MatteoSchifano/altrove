---
/* ─────────────────────────────────────────────────────────────
   SoftSwitch — lo switch fondamentale, come oggetto fisico.

   La tesi del capitolo, nuda: uno switch non ha due *stati*, ha
   due *posizioni*. Il thumb percorre una distanza reale da un capo
   all'altro del binario. È questa fisica — non il colore — a dire
   all'occhio "ora è acceso".

   Perché un <button role="switch">, e non una checkbox ridipinta?
   Perché lo switch ha effetto *immediato*: accende il wifi adesso,
   non "alla conferma del modulo". La checkbox è una scelta differita
   (si applica al submit). Sono due gesti diversi, e la semantica
   deve dire la verità su quale dei due è.

   - role="switch" + aria-checked: lo screen reader annuncia
     "interruttore, attivo / non attivo", non "casella, selezionata".
   - <button> nativo: Spazio ed Enter commutano gratis, focus-visible
     gratis, niente JS per la tastiera.
   - Reduced motion: il thumb non scivola, si trova già in posizione
     (stesso stato finale, nessun viaggio) — via le durate-token che
     collassano a 1ms.
   ───────────────────────────────────────────────────────────── */

interface Props {
  locale?: 'it' | 'en';
}
const { locale = 'it' } = Astro.props;

const COPY = {
  it: {
    label: 'Sincronizzazione in background',
    hint: 'Effetto immediato — niente “salva” da premere.',
    on: 'Attiva',
    off: 'Sospesa',
  },
  en: {
    label: 'Background sync',
    hint: 'Takes effect immediately — no “save” to press.',
    on: 'On',
    off: 'Off',
  },
} as const;
const c = COPY[locale];
---

<div class="soft">
  <span class="soft__text">
    <span class="soft__label" id="soft-label">{c.label}</span>
    <span class="soft__hint">{c.hint}</span>
  </span>

  <button
    type="button"
    class="soft__switch"
    role="switch"
    aria-checked="false"
    aria-labelledby="soft-label"
    data-on={c.on}
    data-off={c.off}
  >
    <span class="soft__track" aria-hidden="true">
      <span class="soft__thumb"></span>
    </span>
    <span class="soft__state" aria-hidden="true">{c.off}</span>
  </button>
</div>

<style>
  .soft {
    inline-size: min(26rem, 100%);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-lg);
    background-color: var(--surface-raised);
    border: 1px solid var(--border);
  }

  .soft__text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .soft__label {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--ink-strong);
    letter-spacing: var(--tracking-snug);
  }
  .soft__hint {
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  /* Il bottone-switch: track + thumb + parolina di stato */
  .soft__switch {
    appearance: none;
    border: 0;
    background: transparent;
    padding: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
    flex-shrink: 0;
  }
  .soft__switch:focus-visible { outline: none; }
  .soft__switch:focus-visible .soft__track { box-shadow: var(--halo-focus); }

  .soft__track {
    position: relative;
    inline-size: 3rem;
    block-size: 1.7rem;
    border-radius: var(--radius-pill);
    /* off: un grigio neutro; on: l'accento. Il colore è il secondo
       segnale; il primo è la posizione del thumb. */
    background-color: var(--border-strong);
    padding: 0.2rem;
    transition: background-color var(--dur-normal) var(--ease-out-soft);
  }

  .soft__thumb {
    display: block;
    inline-size: 1.3rem;
    block-size: 1.3rem;
    border-radius: 50%;
    background-color: var(--surface-raised);
    box-shadow: var(--shadow-sm);
    /* out-snug = il leggero overshoot di un oggetto che si posa */
    transition: transform var(--dur-normal) var(--ease-out-snug);
  }

  .soft__state {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--ink-muted);
    inline-size: 3.5rem;
    text-align: start;
    transition: color var(--dur-fast) var(--ease-out-soft);
  }

  /* ── Acceso ── */
  .soft__switch[aria-checked='true'] .soft__track {
    background-color: var(--accent);
  }
  .soft__switch[aria-checked='true'] .soft__thumb {
    transform: translateX(1.3rem);
  }
  .soft__switch[aria-checked='true'] .soft__state {
    color: var(--accent-ink);
  }
</style>

<script>
  function bind() {
    document.querySelectorAll<HTMLButtonElement>('.soft__switch').forEach((sw) => {
      if (sw.dataset.bound === 'true') return;
      sw.dataset.bound = 'true';

      const state = sw.querySelector<HTMLElement>('.soft__state');
      const on = sw.dataset.on ?? 'On';
      const off = sw.dataset.off ?? 'Off';

      sw.addEventListener('click', () => {
        const next = sw.getAttribute('aria-checked') !== 'true';
        sw.setAttribute('aria-checked', String(next));
        if (state) state.textContent = next ? on : off;
        // Vibrazione hardware lieve dove esiste (mobile): un surrogato
        // del "clac" fisico dello switch reale.
        if (next && 'vibrate' in navigator) navigator.vibrate?.(6);
      });
    });
  }

  document.addEventListener('astro:page-load', bind);
</script>
