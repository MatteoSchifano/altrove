---
/* ─────────────────────────────────────────────────────────────
   CommandPalette — la barra ⌘K: tutte le azioni a portata di
   tastiera, senza cercarle nei menu.

   È il rovescio del dropdown: invece di navigare gerarchie, scrivi
   cosa vuoi e l’azione emerge. Risponde alla domanda del capitolo
   spingendola all’estremo — la scelta non nasconde *nessun*
   contesto, perché parte dall’intenzione scritta dell’utente.

   Il contenitore è un <dialog> nativo, e qui sta il guadagno:
     • focus trap GRATIS — showModal() intrappola il Tab dentro il
       dialog, senza un solo addEventListener('keydown') per ciclare
       i focusable. È l’esempio-manifesto del capitolo «native batte
       le librerie»;
     • Esc chiude di default (evento `cancel`);
     • ::backdrop per l’oscuramento, inerte tutto il resto.

   Sopra, una textbox con role="combobox" + aria-controls verso la
   lista role="listbox": digiti, la lista filtra in tempo reale, le
   frecce muovono l’opzione attiva (aria-activedescendant), Invio
   esegue. Onesto anche nel vuoto: se nessun comando combacia, lo
   diciamo, non mostriamo una lista finta.

   Reduced motion: l’animazione d’entrata del pannello collassa a
   1ms (stesso stato finale, nessun viaggio).
   ───────────────────────────────────────────────────────────── */

interface Props {
  locale?: 'it' | 'en';
}
const { locale = 'it' } = Astro.props;

const COPY = {
  it: {
    open: 'Apri la barra comandi',
    kbd: '⌘K',
    placeholder: 'Cerca un comando…',
    empty: 'Nessun comando trovato.',
    label: 'Comandi',
    commands: [
      { id: 'new-chapter', label: 'Nuovo capitolo', hint: 'Crea' },
      { id: 'toggle-theme', label: 'Cambia tema chiaro/scuro', hint: 'Aspetto' },
      { id: 'go-roadmap', label: 'Vai alla roadmap', hint: 'Naviga' },
      { id: 'switch-lang', label: 'Cambia lingua', hint: 'Naviga' },
      { id: 'copy-link', label: 'Copia link alla pagina', hint: 'Condividi' },
      { id: 'search-docs', label: 'Cerca nei capitoli', hint: 'Trova' },
    ],
    ran: (l: string) => `Eseguito: ${l}`,
  },
  en: {
    open: 'Open the command bar',
    kbd: '⌘K',
    placeholder: 'Search for a command…',
    empty: 'No command found.',
    label: 'Commands',
    commands: [
      { id: 'new-chapter', label: 'New chapter', hint: 'Create' },
      { id: 'toggle-theme', label: 'Toggle light/dark theme', hint: 'Appearance' },
      { id: 'go-roadmap', label: 'Go to roadmap', hint: 'Navigate' },
      { id: 'switch-lang', label: 'Switch language', hint: 'Navigate' },
      { id: 'copy-link', label: 'Copy link to page', hint: 'Share' },
      { id: 'search-docs', label: 'Search the chapters', hint: 'Find' },
    ],
    ran: (l: string) => `Ran: ${l}`,
  },
} as const;
const c = COPY[locale];
const inputId = `cmdk-input-${locale}`;
const listId = `cmdk-list-${locale}`;
const optId = (i: number) => `${listId}-opt-${i}`;
---

<div class="cmdk">
  <button class="cmdk__open" type="button" data-action="open">
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="7" cy="7" r="4.2"/><path d="M10.5 10.5L14 14"/>
    </svg>
    <span>{c.open}</span>
    <kbd class="cmdk__kbd">{c.kbd}</kbd>
  </button>

  <dialog class="cmdk__dialog" aria-label={c.label}>
    <div class="cmdk__panel">
      <div class="cmdk__field">
        <svg class="cmdk__search" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="7" cy="7" r="4.2"/><path d="M10.5 10.5L14 14"/>
        </svg>
        <input
          class="cmdk__input"
          id={inputId}
          type="text"
          role="combobox"
          aria-expanded="true"
          aria-controls={listId}
          aria-autocomplete="list"
          autocomplete="off"
          placeholder={c.placeholder}
          aria-label={c.placeholder}
        />
      </div>

      <ul class="cmdk__list" id={listId} role="listbox" aria-label={c.label}>
        {c.commands.map((cmd, i) => (
          <li
            class="cmdk__opt"
            id={optId(i)}
            role="option"
            aria-selected="false"
            data-id={cmd.id}
            data-label={cmd.label}
            data-search={cmd.label.toLowerCase()}
          >
            <span class="cmdk__opt-label">{cmd.label}</span>
            <span class="cmdk__opt-hint">{cmd.hint}</span>
          </li>
        ))}
        <li class="cmdk__empty" role="presentation" hidden>{c.empty}</li>
      </ul>
    </div>
  </dialog>

  <p class="cmdk__live sr-only" aria-live="polite"></p>
</div>

<style>
  .cmdk {
    inline-size: min(24rem, 100%);
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .cmdk__open {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: 0.55rem 0.85rem;
    border-radius: var(--radius-pill);
    background-color: var(--surface-raised);
    border: 1px solid var(--border);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out-soft),
      border-color var(--dur-fast) var(--ease-out-soft);
  }
  .cmdk__open:hover { background-color: var(--surface); border-color: var(--border-strong); }
  .cmdk__open:focus-visible { outline: none; box-shadow: var(--halo-focus); }
  .cmdk__open svg { inline-size: 0.85rem; block-size: 0.85rem; color: var(--ink-muted); }
  .cmdk__kbd {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius-xs);
    background-color: var(--surface-sunken);
    border: 1px solid var(--border);
    color: var(--ink-muted);
  }

  .cmdk__dialog {
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    inline-size: min(30rem, calc(100% - 2rem));
  }
  .cmdk__dialog:not([open]) { display: none; }
  .cmdk__dialog::backdrop {
    background-color: oklch(0 0 0 / 0.4);
    backdrop-filter: blur(2px);
  }

  @keyframes cmdk-in {
    from { opacity: 0; transform: translateY(-0.6rem) scale(0.98); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes cmdk-out {
    from { opacity: 1; transform: scale(1); }
    to   { opacity: 0; transform: scale(0.98); }
  }
  .cmdk__dialog[open] .cmdk__panel { animation: cmdk-in var(--dur-normal) var(--ease-out-snug); }
  .cmdk__dialog[data-closing='true'] .cmdk__panel { animation: cmdk-out 160ms var(--ease-out-soft) forwards; }

  .cmdk__panel {
    background-color: var(--surface-raised);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
  }

  .cmdk__field {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-sm) var(--space-md);
    border-block-end: 1px solid var(--border);
  }
  .cmdk__search { inline-size: 1rem; block-size: 1rem; color: var(--ink-muted); flex-shrink: 0; }
  .cmdk__input {
    inline-size: 100%;
    border: 0;
    background: transparent;
    color: var(--ink-strong);
    font-size: var(--text-base);
    font-family: inherit;
  }
  .cmdk__input::placeholder { color: var(--ink-subtle); }
  .cmdk__input:focus-visible { outline: none; }

  .cmdk__list {
    list-style: none;
    margin: 0;
    padding: var(--space-3xs);
    max-block-size: 16rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .cmdk__opt {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: 0.5rem 0.65rem;
    border-radius: var(--radius-sm);
    color: var(--ink);
    font-size: var(--text-sm);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out-soft);
  }
  .cmdk__opt[hidden] { display: none; }
  .cmdk__opt:hover { background-color: var(--surface-sunken); }
  /* L’opzione attiva (aria-activedescendant): segno visibile, non solo SR. */
  .cmdk__opt[data-active='true'] {
    background-color: var(--surface-sunken);
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }
  .cmdk__opt-hint {
    font-size: var(--text-2xs);
    color: var(--ink-subtle);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .cmdk__empty {
    padding: var(--space-sm) 0.65rem;
    color: var(--ink-subtle);
    font-size: var(--text-sm);
    text-align: center;
  }
  .cmdk__empty[hidden] { display: none; }

  .sr-only {
    position: absolute;
    inline-size: 1px; block-size: 1px;
    margin: -1px; padding: 0; border: 0;
    overflow: hidden; clip-path: inset(50%);
  }

  @media (prefers-reduced-motion: reduce) {
    .cmdk__dialog[open] .cmdk__panel,
    .cmdk__dialog[data-closing='true'] .cmdk__panel { animation-duration: 1ms; }
  }
</style>

<script>
  function bind() {
    document.querySelectorAll<HTMLElement>('.cmdk').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      const openBtn = root.querySelector<HTMLButtonElement>('[data-action="open"]')!;
      const dialog = root.querySelector<HTMLDialogElement>('.cmdk__dialog')!;
      const input = root.querySelector<HTMLInputElement>('.cmdk__input')!;
      const list = root.querySelector<HTMLElement>('.cmdk__list')!;
      const options = Array.from(root.querySelectorAll<HTMLElement>('.cmdk__opt'));
      const empty = root.querySelector<HTMLElement>('.cmdk__empty')!;
      const live = root.querySelector<HTMLElement>('.cmdk__live')!;

      let visible: HTMLElement[] = [...options];
      let active = 0;

      const setActive = (i: number) => {
        if (visible.length === 0) { input.removeAttribute('aria-activedescendant'); return; }
        active = (i + visible.length) % visible.length;
        options.forEach((o) => o.removeAttribute('data-active'));
        const opt = visible[active];
        opt.dataset.active = 'true';
        input.setAttribute('aria-activedescendant', opt.id);
        opt.scrollIntoView({ block: 'nearest' });
      };

      const filter = () => {
        const q = input.value.trim().toLowerCase();
        visible = options.filter((o) => {
          const match = q === '' || (o.dataset.search ?? '').includes(q);
          o.hidden = !match;
          return match;
        });
        empty.hidden = visible.length > 0;
        active = 0;
        setActive(0);
      };

      const run = (opt: HTMLElement | undefined) => {
        if (!opt) return;
        live.textContent = opt.dataset.label ?? '';
        close();
      };

      const open = () => {
        dialog.showModal();
        input.value = '';
        filter();
        requestAnimationFrame(() => input.focus());
      };

      const close = () => {
        if (!dialog.open) return;
        dialog.dataset.closing = 'true';
        const onEnd = () => {
          dialog.removeEventListener('animationend', onEnd);
          dialog.close();
          delete dialog.dataset.closing;
        };
        dialog.addEventListener('animationend', onEnd);
        // rete di sicurezza se l’animationend non scatta
        setTimeout(() => { if (dialog.dataset.closing) onEnd(); }, 220);
      };

      openBtn.addEventListener('click', open);

      // ⌘K / Ctrl+K apre la barra (scope: documento).
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          if (!dialog.open) open();
        }
      });

      input.addEventListener('input', filter);

      input.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
        else if (e.key === 'Home') { e.preventDefault(); setActive(0); }
        else if (e.key === 'End') { e.preventDefault(); setActive(visible.length - 1); }
        else if (e.key === 'Enter') { e.preventDefault(); run(visible[active]); }
      });

      options.forEach((opt) => {
        opt.addEventListener('click', () => run(opt));
      });

      // Esc: il dialog emette `cancel`; lo intercettiamo per animare l’uscita.
      dialog.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
      // Click sul backdrop chiude.
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) close();
      });
    });
  }

  document.addEventListener('astro:page-load', bind);
</script>
