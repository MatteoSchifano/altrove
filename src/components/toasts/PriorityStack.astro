---
/* ─────────────────────────────────────────────────────────────
   PriorityStack — toast di priorità diverse che convivono.

   Un toast non arriva mai da solo per sempre. Prima o poi due
   informazioni si sovrappongono: una conferma e un avviso, un
   errore e un "salvato". Lo stack le accatasta in ordine, le fa
   scadere una a una e si ricompone quando una se ne va.

   La tesi: ogni livello ha un *segno* oltre al colore. Verde+spunta
   per success, ambra+triangolo per warning, rosso+ottagono per
   error, blu+"i" per info. Chi non distingue i colori legge l’icona
   e l’etichetta — il colore è il terzo canale, mai l’unico.

   - aria-live="polite": lo screen reader annuncia i toast quando
     può, senza interrompere ciò che l’utente sta facendo. È la
     voce giusta per un’informazione che non è un’emergenza.
   - Lo stack si ricompone con un riflow lieve: i superstiti scivolano
     a colmare il vuoto, non sobbalzano.
   - Reduced motion: niente entrata né uscita animata, lo stato finale
     è identico — il toast c’è o non c’è.
   ───────────────────────────────────────────────────────────── */

interface Props {
  locale?: 'it' | 'en';
}
const { locale = 'it' } = Astro.props;

const COPY = {
  it: {
    launch: 'Lancia un toast',
    clear: 'Svuota',
    region: 'Notifiche',
    levels: {
      info: { tag: 'Info', text: 'Backup pianificato per stanotte alle 03:00.' },
      success: { tag: 'Fatto', text: 'Bozza salvata — 3 minuti fa.' },
      warning: { tag: 'Attenzione', text: 'Spazio quasi pieno: restano 8 foto.' },
      error: { tag: 'Errore', text: 'Invio non riuscito: nessuna connessione.' },
    },
  },
  en: {
    launch: 'Launch a toast',
    clear: 'Clear',
    region: 'Notifications',
    levels: {
      info: { tag: 'Info', text: 'Backup scheduled for tonight at 03:00.' },
      success: { tag: 'Done', text: 'Draft saved — 3 minutes ago.' },
      warning: { tag: 'Heads up', text: 'Storage almost full: 8 photos left.' },
      error: { tag: 'Error', text: 'Send failed: no connection.' },
    },
  },
} as const;
const c = COPY[locale];

const order = ['info', 'success', 'warning', 'error'] as const;
---

<div class="pstack">
  <div class="pstack__controls">
    <button type="button" class="pstack__btn" data-launch>{c.launch}</button>
    <button type="button" class="pstack__btn pstack__btn--ghost" data-clear>{c.clear}</button>
  </div>

  <ul
    class="pstack__list"
    role="status"
    aria-live="polite"
    aria-label={c.region}
    data-stack
  ></ul>

  {/* Template nascosti: copia onesta per ogni livello */}
  <template data-levels>
    {order.map((level) => (
      <li class="pstack__toast" data-level={level} data-tag={c.levels[level].tag}>
        <span class="pstack__icon" aria-hidden="true">
          {level === 'info' && (
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="10" cy="10" r="7.5" /><path d="M10 9v4.5" /><path d="M10 6.4h.01" />
            </svg>
          )}
          {level === 'success' && (
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="10" cy="10" r="7.5" /><path d="M6.6 10.3l2.2 2.2 4.6-4.8" />
            </svg>
          )}
          {level === 'warning' && (
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 2.8 18 16.5H2L10 2.8Z" /><path d="M10 8v3.4" /><path d="M10 14.1h.01" />
            </svg>
          )}
          {level === 'error' && (
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6.7 2.7h6.6L17.3 6.7v6.6L13.3 17.3H6.7L2.7 13.3V6.7L6.7 2.7Z" /><path d="M10 6.7v4" /><path d="M10 13.3h.01" />
            </svg>
          )}
        </span>
        <span class="pstack__body">
          <span class="pstack__tag">{c.levels[level].tag}</span>
          <span class="pstack__text">{c.levels[level].text}</span>
        </span>
      </li>
    ))}
  </template>
</div>

<style>
  .pstack {
    inline-size: min(26rem, 100%);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .pstack__controls {
    display: flex;
    gap: var(--space-2xs);
  }

  .pstack__btn {
    padding: 0.55rem 1.1rem;
    border-radius: var(--radius-pill);
    background-color: var(--ink-strong);
    color: var(--bg);
    border: 1px solid var(--ink-strong);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    cursor: pointer;
    transition:
      transform var(--dur-fast) var(--ease-out-snug),
      box-shadow var(--dur-fast) var(--ease-out-soft);
  }
  .pstack__btn:hover { transform: translateY(-1px); box-shadow: var(--shadow-md); }
  .pstack__btn:active { transform: translateY(0); }
  .pstack__btn:focus-visible { outline: none; box-shadow: var(--halo-focus); }
  .pstack__btn--ghost {
    background: transparent;
    color: var(--ink-muted);
    border-color: var(--border);
  }
  .pstack__btn--ghost:hover { color: var(--ink-strong); box-shadow: none; }

  .pstack__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    min-block-size: 1px;
  }

  .pstack__toast {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: 0.7rem var(--space-sm);
    border-radius: var(--radius-md);
    background-color: var(--surface-raised);
    border: 1px solid var(--border);
    border-inline-start: 3px solid var(--tone);
    box-shadow: var(--shadow-sm);
    /* Entrata: scivola da sopra e dissolve */
    animation: pstack-in var(--dur-normal) var(--ease-out-snug);
  }
  .pstack__toast[data-leaving='true'] {
    animation: pstack-out var(--dur-fast) var(--ease-in) forwards;
  }

  /* Ogni livello: un --tone diverso, sempre accoppiato a icona+segno */
  .pstack__toast[data-level='info']    { --tone: oklch(0.62 0.13 240); }
  .pstack__toast[data-level='success'] { --tone: oklch(0.62 0.15 150); }
  .pstack__toast[data-level='warning'] { --tone: oklch(0.70 0.15 75); }
  .pstack__toast[data-level='error']   { --tone: oklch(0.58 0.19 25); }

  .pstack__icon {
    flex-shrink: 0;
    color: var(--tone);
    inline-size: 1.2rem;
    block-size: 1.2rem;
    margin-block-start: 0.05rem;
  }
  .pstack__icon svg { inline-size: 100%; block-size: 100%; }

  .pstack__body {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .pstack__tag {
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--tone);
  }
  .pstack__text {
    font-size: var(--text-sm);
    color: var(--ink);
    line-height: var(--leading-snug);
  }

  @keyframes pstack-in {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes pstack-out {
    from { opacity: 1; transform: translateY(0); }
    to   { opacity: 0; transform: translateY(-4px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pstack__toast,
    .pstack__toast[data-leaving='true'] {
      animation: none !important;
    }
  }
</style>

<script>
  type Level = 'info' | 'success' | 'warning' | 'error';

  function bind() {
    document.querySelectorAll<HTMLElement>('.pstack').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      const launch = root.querySelector<HTMLButtonElement>('[data-launch]')!;
      const clear = root.querySelector<HTMLButtonElement>('[data-clear]')!;
      const list = root.querySelector<HTMLElement>('[data-stack]')!;
      const template = root.querySelector<HTMLTemplateElement>('[data-levels]')!;

      // I quattro <li> modello, indicizzati per livello.
      const models = new Map<Level, HTMLLIElement>();
      template.content.querySelectorAll<HTMLLIElement>('.pstack__toast').forEach((li) => {
        models.set(li.dataset.level as Level, li);
      });

      const levels: Level[] = ['info', 'success', 'warning', 'error'];
      const timers = new Set<number>();
      // Tempi di vita onesti: più alta la priorità, più resta leggibile.
      const lifeFor: Record<Level, number> = {
        info: 4000,
        success: 3500,
        warning: 5500,
        error: 7000,
      };

      const dismiss = (toast: HTMLElement) => {
        if (toast.dataset.leaving === 'true') return;
        toast.dataset.leaving = 'true';
        const done = () => toast.remove();
        toast.addEventListener('animationend', done, { once: true });
        // Fallback se l’animazione è disattivata (reduced motion).
        const t = window.setTimeout(done, 260);
        timers.add(t);
      };

      const spawn = () => {
        const level = levels[Math.floor(Math.random() * levels.length)]!;
        const node = models.get(level)!.cloneNode(true) as HTMLElement;
        list.appendChild(node);
        const t = window.setTimeout(() => dismiss(node), lifeFor[level]);
        timers.add(t);
      };

      launch.addEventListener('click', spawn);
      clear.addEventListener('click', () => {
        list.querySelectorAll<HTMLElement>('.pstack__toast').forEach(dismiss);
      });
    });
  }

  document.addEventListener('astro:page-load', bind);
</script>
