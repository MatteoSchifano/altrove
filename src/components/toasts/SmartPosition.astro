---
/* ─────────────────────────────────────────────────────────────
   SmartPosition — il posto del toast non è arbitrario.

   Dentro un finto "viewport" mostriamo due regole di posizionamento
   per tipo, perché il *dove* è informazione quanto il *cosa*:

   - SUCCESS in alto a destra: una conferma è periferica. Vive
     vicino all’azione che l’ha generata (di solito un pulsante in
     alto), e non deve coprire ciò su cui l’utente sta lavorando.
   - OFFLINE/STATO DI SISTEMA in basso al centro: riguarda l’intera
     app, non un singolo gesto. Sta sul bordo inferiore, ben visibile
     ma fuori dal flusso di lettura, dove convenzionalmente vivono le
     barre di stato.

   La logica sotto: posiziona vicino alla causa quando il toast
   risponde a un’azione locale; posiziona in un punto stabile e
   condiviso quando riguarda lo stato globale. Mai sopra il contenuto
   attivo, mai dove copre il prossimo gesto.

   - aria-live="polite": entrambi annunciano senza interrompere.
   - Reduced motion: appaiono già in posizione, nessuno scorrimento.
   ───────────────────────────────────────────────────────────── */

interface Props {
  locale?: 'it' | 'en';
}
const { locale = 'it' } = Astro.props;

const COPY = {
  it: {
    chrome: 'altrove · app',
    successBtn: 'Pubblica',
    offlineBtn: 'Vai offline',
    successTag: 'Fatto',
    successMsg: 'Articolo pubblicato',
    offlineTag: 'Sistema',
    offlineMsg: 'Sei offline — le modifiche si sincronizzano al ritorno della rete.',
    legendTop: 'Conferma · in alto a destra, vicino all’azione',
    legendBottom: 'Stato globale · in basso al centro, fuori dal flusso',
  },
  en: {
    chrome: 'altrove · app',
    successBtn: 'Publish',
    offlineBtn: 'Go offline',
    successTag: 'Done',
    successMsg: 'Article published',
    offlineTag: 'System',
    offlineMsg: 'You’re offline — changes will sync when the network returns.',
    legendTop: 'Confirmation · top-right, near the action',
    legendBottom: 'Global status · bottom-center, out of the flow',
  },
} as const;
const c = COPY[locale];
---

<div class="spos">
  <div class="spos__viewport" data-viewport>
    <div class="spos__chrome">
      <span class="spos__dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="spos__url">{c.chrome}</span>
    </div>

    <div class="spos__canvas">
      {/* contenuto fittizio: serve a far vedere che i toast non lo coprono */}
      <div class="spos__line spos__line--lg" aria-hidden="true"></div>
      <div class="spos__line" aria-hidden="true"></div>
      <div class="spos__line spos__line--sm" aria-hidden="true"></div>

      {/* SUCCESS — alto a destra */}
      <div class="spos__toast spos__toast--success" data-toast="success" data-state="hidden" aria-hidden="true">
        <span class="spos__icon">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="10" cy="10" r="7.5" /><path d="M6.6 10.3l2.2 2.2 4.6-4.8" />
          </svg>
        </span>
        <span class="spos__t-body">
          <span class="spos__t-tag">{c.successTag}</span>
          <span class="spos__t-text">{c.successMsg}</span>
        </span>
      </div>

      {/* OFFLINE — basso al centro */}
      <div class="spos__toast spos__toast--offline" data-toast="offline" data-state="hidden" aria-hidden="true">
        <span class="spos__icon">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 3l14 14" /><path d="M5.5 8.3a9 9 0 0 1 3-1.8M2.5 6a13 13 0 0 1 4-2.3M10 13.6h.01M7.4 11a5 5 0 0 1 5.1-1.1M14.4 8.4a9 9 0 0 1 3 1.9" />
          </svg>
        </span>
        <span class="spos__t-body">
          <span class="spos__t-tag">{c.offlineTag}</span>
          <span class="spos__t-text">{c.offlineMsg}</span>
        </span>
      </div>

      {/* Regione viva per gli screen reader, fuori dal viewport visivo */}
      <p class="spos__sr" role="status" aria-live="polite" data-live></p>
    </div>
  </div>

  <div class="spos__controls">
    <button type="button" class="spos__btn" data-fire="success">{c.successBtn}</button>
    <button type="button" class="spos__btn spos__btn--ghost" data-fire="offline">{c.offlineBtn}</button>
  </div>

  <dl class="spos__legend">
    <div><dt class="spos__dot spos__dot--success" aria-hidden="true"></dt><dd>{c.legendTop}</dd></div>
    <div><dt class="spos__dot spos__dot--offline" aria-hidden="true"></dt><dd>{c.legendBottom}</dd></div>
  </dl>
</div>

<style>
  .spos {
    inline-size: min(32rem, 100%);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .spos__viewport {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    background-color: var(--surface-sunken);
    box-shadow: var(--shadow-sm);
  }

  .spos__chrome {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.45rem var(--space-sm);
    background-color: var(--surface-raised);
    border-block-end: 1px solid var(--border);
  }
  .spos__dots { display: inline-flex; gap: 0.3rem; }
  .spos__dots i {
    inline-size: 0.5rem; block-size: 0.5rem; border-radius: 50%;
    background-color: var(--border-strong);
  }
  .spos__url {
    font-size: var(--text-2xs);
    color: var(--ink-subtle);
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-snug);
  }

  .spos__canvas {
    position: relative;
    min-block-size: 13rem;
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .spos__line {
    block-size: 0.6rem;
    border-radius: var(--radius-pill);
    background-color: color-mix(in oklab, var(--ink) 10%, transparent);
  }
  .spos__line--lg { inline-size: 55%; block-size: 0.9rem; }
  .spos__line--sm { inline-size: 35%; }

  .spos__toast {
    position: absolute;
    display: flex;
    align-items: flex-start;
    gap: var(--space-2xs);
    inline-size: min(15rem, 70%);
    padding: 0.55rem 0.7rem;
    border-radius: var(--radius-md);
    background-color: var(--surface-raised);
    border: 1px solid var(--border);
    border-inline-start: 3px solid var(--tone);
    box-shadow: var(--shadow-md);
    opacity: 0;
  }
  .spos__toast[data-state='shown'] { opacity: 1; }

  /* SUCCESS: alto a destra, entra dall’alto */
  .spos__toast--success {
    --tone: oklch(0.62 0.15 150);
    inset-block-start: var(--space-sm);
    inset-inline-end: var(--space-sm);
    transform: translateY(-6px);
    transition: opacity var(--dur-normal) var(--ease-out-soft), transform var(--dur-normal) var(--ease-out-snug);
  }
  .spos__toast--success[data-state='shown'] { transform: translateY(0); }

  /* OFFLINE: basso al centro, entra dal basso */
  .spos__toast--offline {
    --tone: oklch(0.62 0.13 240);
    inset-block-end: var(--space-sm);
    inset-inline-start: 50%;
    transform: translateX(-50%) translateY(6px);
    transition: opacity var(--dur-normal) var(--ease-out-soft), transform var(--dur-normal) var(--ease-out-snug);
  }
  .spos__toast--offline[data-state='shown'] { transform: translateX(-50%) translateY(0); }

  .spos__icon { flex-shrink: 0; color: var(--tone); inline-size: 1rem; block-size: 1rem; margin-block-start: 0.05rem; }
  .spos__icon svg { inline-size: 100%; block-size: 100%; }

  .spos__t-body { display: flex; flex-direction: column; gap: 0.05rem; }
  .spos__t-tag {
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--tone);
  }
  .spos__t-text { font-size: var(--text-xs); color: var(--ink); line-height: var(--leading-snug); }

  .spos__sr {
    position: absolute;
    inline-size: 1px; block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    margin: 0;
  }

  .spos__controls { display: flex; gap: var(--space-2xs); }
  .spos__btn {
    padding: 0.5rem 1rem;
    border-radius: var(--radius-pill);
    background-color: var(--ink-strong);
    color: var(--bg);
    border: 1px solid var(--ink-strong);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    cursor: pointer;
    transition: transform var(--dur-fast) var(--ease-out-snug), box-shadow var(--dur-fast) var(--ease-out-soft);
  }
  .spos__btn:hover { transform: translateY(-1px); box-shadow: var(--shadow-md); }
  .spos__btn:active { transform: translateY(0); }
  .spos__btn:focus-visible { outline: none; box-shadow: var(--halo-focus); }
  .spos__btn--ghost { background: transparent; color: var(--ink-muted); border-color: var(--border); }
  .spos__btn--ghost:hover { color: var(--ink-strong); box-shadow: none; }

  .spos__legend {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }
  .spos__legend > div { display: flex; align-items: center; gap: var(--space-2xs); }
  .spos__legend dd { margin: 0; font-size: var(--text-xs); color: var(--ink-muted); }
  .spos__dot { inline-size: 0.6rem; block-size: 0.6rem; border-radius: 50%; flex-shrink: 0; }
  .spos__dot--success { background-color: oklch(0.62 0.15 150); }
  .spos__dot--offline { background-color: oklch(0.62 0.13 240); }

  @media (prefers-reduced-motion: reduce) {
    .spos__toast--success,
    .spos__toast--offline { transition-duration: 1ms; }
  }
</style>

<script>
  function bind() {
    document.querySelectorAll<HTMLElement>('.spos').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      const live = root.querySelector<HTMLElement>('[data-live]')!;
      const timers = new Map<string, number>();

      const fire = (kind: string) => {
        const toast = root.querySelector<HTMLElement>(`[data-toast="${kind}"]`);
        if (!toast) return;

        const prev = timers.get(kind);
        if (prev) clearTimeout(prev);

        toast.dataset.state = 'hidden';
        void toast.offsetWidth;
        toast.dataset.state = 'shown';
        // Annuncio testuale per gli screen reader (i toast visivi sono aria-hidden).
        const text = toast.querySelector<HTMLElement>('.spos__t-text')?.textContent ?? '';
        live.textContent = text;

        const t = window.setTimeout(() => {
          toast.dataset.state = 'hidden';
          if (live.textContent === text) live.textContent = '';
        }, kind === 'success' ? 3000 : 4500);
        timers.set(kind, t);
      };

      root.querySelectorAll<HTMLButtonElement>('[data-fire]').forEach((btn) => {
        btn.addEventListener('click', () => fire(btn.dataset.fire!));
      });
    });
  }

  document.addEventListener('astro:page-load', bind);
</script>
