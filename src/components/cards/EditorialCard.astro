---
/* ─────────────────────────────────────────────────────────────
   EditorialCard — la card editoriale, e perché non è un rettangolo.

   La tesi del capitolo nuda: una card non è un bordo con dentro
   del testo. È una *gerarchia* — un oggetto che dice in che ordine
   leggere ciò che contiene. Immagine, occhiello, titolo, lede:
   ognuno occupa un gradino, e il gradino è il messaggio.

   Due scelte di mestiere qui:
   - L’immagine è un placeholder a gradient CSS con aspect-ratio,
     nessun file: la *forma* c’è prima del contenuto, così il layout
     non sobbalza quando l’immagine vera arriverà (niente CLS).
   - Lo stato di hover è *derivato* con :has(). Non lego l’effetto a
     ":hover sul titolo" né a ":hover sull’immagine": dico alla card
     «se contieni un link su cui c’è il puntatore, illuminati». È la
     card a reagire come un tutt’uno, non le sue parti scollegate.

   Reduced motion: le transizioni collassano via token (--dur-*),
   lo stato finale resta identico — niente viaggio, stessa meta.
   ───────────────────────────────────────────────────────────── */

interface Props {
  locale?: 'it' | 'en';
}
const { locale = 'it' } = Astro.props;

const COPY = {
  it: {
    eyebrow: 'Reportage',
    readtime: '6 min',
    title: 'La luce delle sei del mattino, e perché nessuno la fotografa bene',
    lede: 'Un’ora che i manuali chiamano “magica” e che quasi sempre esce piatta. Non è la macchina: è quello che facciamo nei dieci minuti prima.',
    cta: 'Leggi il pezzo',
  },
  en: {
    eyebrow: 'Reportage',
    readtime: '6 min',
    title: 'Six in the morning, and why nobody photographs that light well',
    lede: 'An hour the manuals call “magic” and that almost always comes out flat. It isn’t the camera: it’s what we do in the ten minutes before.',
    cta: 'Read the piece',
  },
} as const;
const c = COPY[locale];
---

<article class="ec">
  <div class="ec__media" aria-hidden="true">
    <span class="ec__media-grain"></span>
  </div>

  <div class="ec__body">
    <div class="ec__meta">
      <span class="ec__eyebrow">{c.eyebrow}</span>
      <span class="ec__dot" aria-hidden="true">·</span>
      <span class="ec__readtime tabular">{c.readtime}</span>
    </div>

    <h3 class="ec__title">
      <a class="ec__link" href="#editorial-card">{c.title}</a>
    </h3>

    <p class="ec__lede">{c.lede}</p>

    <span class="ec__cue" aria-hidden="true">
      {c.cta}
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 8h10M9 4l4 4-4 4" />
      </svg>
    </span>
  </div>
</article>

<style>
  .ec {
    position: relative;
    inline-size: min(22rem, 100%);
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background-color: var(--surface-raised);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    transition:
      border-color var(--dur-normal) var(--ease-out-soft),
      box-shadow var(--dur-normal) var(--ease-out-soft);
  }

  /* Lo stato derivato: la card reagisce come un tutt’uno se il
     puntatore (o il focus) è sul suo link. :has() lega l’effetto
     al link, non a un singolo elemento decorativo. */
  .ec:has(.ec__link:hover),
  .ec:has(.ec__link:focus-visible) {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-lg);
  }

  /* ── Immagine: placeholder a gradient, forma prima del contenuto ── */
  .ec__media {
    position: relative;
    aspect-ratio: 16 / 9;
    background:
      radial-gradient(
        ellipse at 28% 18%,
        color-mix(in oklab, var(--accent) 55%, transparent),
        transparent 58%
      ),
      linear-gradient(
        145deg,
        var(--accent-soft),
        color-mix(in oklab, var(--accent) 22%, var(--surface-sunken))
      );
  }

  .ec__media-grain {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      oklch(0 0 0 / 0.06) 1px,
      transparent 1px
    );
    background-size: 0.5rem 0.5rem;
    opacity: 0.5;
  }

  .ec__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-md);
  }

  .ec__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    font-size: var(--text-2xs);
    color: var(--ink-subtle);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    font-family: var(--font-mono);
  }
  .ec__dot { opacity: 0.6; }

  .ec__title {
    font-size: var(--text-md);
    color: var(--ink-strong);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
    margin-block: var(--space-3xs) 0;
    text-wrap: balance;
  }

  .ec__link {
    color: inherit;
    text-decoration: none;
    /* il titolo si illumina con lo stato derivato della card */
    transition: color var(--dur-fast) var(--ease-out-soft);
  }
  .ec__link::after {
    /* stretched-link: il link copre tutta la card, ma il testo resta
       selezionabile (l’overlay è ::after, non il testo del link) */
    content: '';
    position: absolute;
    inset: 0;
  }
  .ec__link:focus-visible { outline: none; }

  .ec:has(.ec__link:hover) .ec__link,
  .ec:has(.ec__link:focus-visible) .ec__link {
    color: var(--accent-ink);
  }
  /* l’anello di focus si disegna sull’intera card, non sul solo testo */
  .ec:has(.ec__link:focus-visible) {
    box-shadow: var(--shadow-lg), var(--halo-focus);
  }

  .ec__lede {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
    max-inline-size: none;
  }

  .ec__cue {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    margin-block-start: var(--space-2xs);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--ink-muted);
    transition:
      color var(--dur-fast) var(--ease-out-soft),
      gap var(--dur-fast) var(--ease-out-snug);
  }
  .ec__cue svg {
    inline-size: 0.85rem;
    block-size: 0.85rem;
  }
  .ec:has(.ec__link:hover) .ec__cue,
  .ec:has(.ec__link:focus-visible) .ec__cue {
    color: var(--accent-ink);
    gap: var(--space-2xs);
  }
</style>
