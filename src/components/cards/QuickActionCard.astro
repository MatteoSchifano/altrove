---
/* ─────────────────────────────────────────────────────────────
   QuickActionCard — la card "azione rapida", interamente cliccabile.

   Il problema: vogliamo che TUTTA la card sia un bersaglio (la legge
   di Fitts premia i bersagli grandi), ma senza avvolgere mezzo
   paragrafo dentro un <a>. Avvolgere tutto in un link rompe due cose:
   il testo non si seleziona più, e ogni sotto-azione interna
   finirebbe annidata in un link — invalido e inaccessibile.

   La tecnica onesta è lo "stretched link":
   - un <a> normale sul titolo (lettura corretta per screen reader e
     focus), con un ::after che si estende a coprire tutta la card.
     Il click vuoto sulla card cade sul link; il testo resta
     selezionabile perché l’overlay è uno pseudo-elemento, non il
     testo.
   - le sotto-azioni reali (un menu, un secondario) si rialzano con
     position:relative + z-index: stanno SOPRA l’overlay, quindi
     restano cliccabili e raggiungibili da tastiera. Ognuna è un
     controllo vero, non un finto bottone.

   Niente JS: è tutto stato del browser. Reduced motion: le micro
   transizioni collassano via token, lo stato finale è identico.
   ───────────────────────────────────────────────────────────── */

interface Props {
  locale?: 'it' | 'en';
}
const { locale = 'it' } = Astro.props;

const COPY = {
  it: {
    eyebrow: 'Bozza',
    title: 'Resoconto di marzo',
    meta: 'Modificato 2 giorni fa · 3 collaboratori',
    open: 'Apri il documento',
    share: 'Condividi',
    more: 'Altre azioni',
    hint: 'Il titolo apre. Le icone restano azioni a sé.',
  },
  en: {
    eyebrow: 'Draft',
    title: 'March report',
    meta: 'Edited 2 days ago · 3 collaborators',
    open: 'Open the document',
    share: 'Share',
    more: 'More actions',
    hint: 'The title opens it. The icons stay separate actions.',
  },
} as const;
const c = COPY[locale];
---

<article class="qa">
  <div class="qa__head">
    <span class="qa__eyebrow">{c.eyebrow}</span>

    <div class="qa__actions">
      <button type="button" class="qa__icon" aria-label={c.share}>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="3.5" r="1.6" /><circle cx="4" cy="8" r="1.6" /><circle cx="12" cy="12.5" r="1.6" />
          <path d="M10.6 4.4 5.4 7.1M5.4 8.9l5.2 2.7" />
        </svg>
      </button>
      <button type="button" class="qa__icon" aria-label={c.more}>
        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <circle cx="3.5" cy="8" r="1.4" /><circle cx="8" cy="8" r="1.4" /><circle cx="12.5" cy="8" r="1.4" />
        </svg>
      </button>
    </div>
  </div>

  <h3 class="qa__title">
    <a class="qa__link" href="#quick-action-card">{c.open}: {c.title}</a>
  </h3>

  <p class="qa__meta">{c.meta}</p>
  <p class="qa__hint">{c.hint}</p>
</article>

<style>
  .qa {
    position: relative; /* àncora per l’overlay ::after del link */
    inline-size: min(24rem, 100%);
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-md);
    border-radius: var(--radius-lg);
    background-color: var(--surface-raised);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    transition:
      border-color var(--dur-normal) var(--ease-out-soft),
      box-shadow var(--dur-normal) var(--ease-out-soft);
  }
  .qa:has(.qa__link:hover),
  .qa:has(.qa__link:focus-visible) {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }
  .qa:has(.qa__link:focus-visible) {
    box-shadow: var(--shadow-md), var(--halo-focus);
  }

  .qa__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .qa__eyebrow {
    font-size: var(--text-2xs);
    color: var(--ink-subtle);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    font-family: var(--font-mono);
  }

  /* Le sotto-azioni si rialzano SOPRA l’overlay del link → restano
     cliccabili e raggiungibili da tastiera. */
  .qa__actions {
    position: relative;
    z-index: 1;
    display: flex;
    gap: var(--space-3xs);
  }

  .qa__icon {
    appearance: none;
    display: grid;
    place-items: center;
    inline-size: 1.9rem;
    block-size: 1.9rem;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    background: transparent;
    color: var(--ink-muted);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out-soft),
      color var(--dur-fast) var(--ease-out-soft);
  }
  .qa__icon svg { inline-size: 1rem; block-size: 1rem; }
  .qa__icon:hover {
    background-color: var(--surface-sunken);
    color: var(--ink-strong);
  }
  .qa__icon:focus-visible {
    outline: none;
    color: var(--ink-strong);
    box-shadow: var(--halo-focus);
  }

  .qa__title {
    font-size: var(--text-md);
    color: var(--ink-strong);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
    margin: var(--space-3xs) 0 0;
  }

  .qa__link {
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out-soft);
  }
  .qa__link:focus-visible { outline: none; }
  /* Lo stretched-link: l’overlay copre la card, il testo del titolo
     resta selezionabile (il testo non è l’overlay). */
  .qa__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .qa:has(.qa__link:hover) .qa__link,
  .qa:has(.qa__link:focus-visible) .qa__link {
    color: var(--accent-ink);
  }

  .qa__meta {
    font-size: var(--text-xs);
    color: var(--ink-muted);
    margin: 0;
    max-inline-size: none;
  }

  .qa__hint {
    font-size: var(--text-2xs);
    color: var(--ink-subtle);
    margin: var(--space-3xs) 0 0;
    max-inline-size: none;
  }
</style>
