---
/* ─────────────────────────────────────────────────────────────
   FontVoice — le cifre che il font sa comporre.

   Un font non porta solo lettere: porta delle istruzioni su come
   comporre i NUMERI. Epilogue Variable, in particolare, espone (l'ho
   verificato misurando il rendering, non a fiducia) sia le frazioni
   diagonali sia le cifre tabulari. Non tutti i font le hanno: prima
   di promettere una feature in una demo, si controlla che il font
   la componga davvero — un capitolo onesto sulla tipografia non finge.

   Due interruttori, due feature REALI e visibili:
     • Frazioni (frac) → "1/2" diventa il glifo ½, non tre caratteri.
     • Cifre incolonnate (tnum) → ogni cifra prende la stessa
       larghezza, e la colonna di numeri si allinea in verticale.

   Niente motion: la sostituzione dei glifi non si anima.
   ───────────────────────────────────────────────────────────── */

interface Props {
  locale?: 'it' | 'en';
}
const { locale = 'it' } = Astro.props;

const COPY = {
  it: {
    frac: 'Frazioni',
    tnum: 'Cifre incolonnate',
    recipe: '1 1/2 tazza di farina, 3/4 di zucchero, 1/3 di latte',
    rows: ['8,90', '124,50', '1.250,00'],
  },
  en: {
    frac: 'Fractions',
    tnum: 'Aligned figures',
    recipe: '1 1/2 cups of flour, 3/4 sugar, 1/3 milk',
    rows: ['8.90', '124.50', '1,250.00'],
  },
} as const;
const c = COPY[locale];
---

<div class="voice">
  <div class="voice__stage">
    <p class="voice__recipe" data-frac="off">{c.recipe}</p>
    <div class="voice__column" data-tnum="off" aria-hidden="true">
      {c.rows.map((n) => <span class="voice__num">{n}</span>)}
    </div>
  </div>

  <div class="voice__controls">
    <label class="voice__switch">
      <input type="checkbox" class="voice__check" data-prop="frac" />
      <span class="voice__track" aria-hidden="true"><span class="voice__thumb"></span></span>
      <span>{c.frac}</span>
    </label>
    <label class="voice__switch">
      <input type="checkbox" class="voice__check" data-prop="tnum" />
      <span class="voice__track" aria-hidden="true"><span class="voice__thumb"></span></span>
      <span>{c.tnum}</span>
    </label>
  </div>
</div>

<style>
  .voice {
    inline-size: min(32rem, 100%);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .voice__stage {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md) var(--space-lg);
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-lg);
    background-color: var(--surface-raised);
    border: 1px solid var(--border);
  }

  .voice__recipe {
    margin: 0;
    flex: 1 1 16rem;
    max-inline-size: none;
    font-size: var(--text-md);
    color: var(--ink-strong);
    line-height: var(--leading-snug);
    /* parte "grezza": niente frazioni, le scrive 1/2 */
    font-variant-numeric: normal;
  }

  .voice__recipe[data-frac='on'] { font-variant-numeric: diagonal-fractions; }

  /* colonna di numeri: a destra, così l'allineamento (o il suo
     fallimento) si legge a colpo d'occhio sui bordi delle cifre */
  .voice__column {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
    font-size: var(--text-md);
    color: var(--ink);
    font-variant-numeric: proportional-nums;
  }

  .voice__column[data-tnum='on'] { font-variant-numeric: tabular-nums; }

  /* ── switch (stesso linguaggio del resto del capitolo) ── */
  .voice__controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .voice__switch {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-size: var(--text-sm);
    color: var(--ink-strong);
    font-weight: var(--weight-medium);
  }

  .voice__check {
    position: absolute;
    opacity: 0;
    inline-size: 1px;
    block-size: 1px;
  }

  .voice__track {
    inline-size: 2.25rem;
    block-size: 1.3rem;
    border-radius: var(--radius-pill);
    background-color: var(--border-strong);
    padding: 0.15rem;
    transition: background-color var(--dur-fast) var(--ease-out-soft);
    flex-shrink: 0;
  }

  .voice__thumb {
    display: block;
    inline-size: 1rem;
    block-size: 1rem;
    border-radius: 50%;
    background-color: var(--surface-raised);
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur-fast) var(--ease-out-snappy);
  }

  .voice__check:checked + .voice__track { background-color: var(--accent); }
  .voice__check:checked + .voice__track .voice__thumb { transform: translateX(0.95rem); }
  .voice__check:focus-visible + .voice__track { box-shadow: var(--halo-focus); }
</style>

<script>
  function bind() {
    document.querySelectorAll<HTMLElement>('.voice').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      const recipe = root.querySelector<HTMLElement>('.voice__recipe');
      const column = root.querySelector<HTMLElement>('.voice__column');
      const checks = root.querySelectorAll<HTMLInputElement>('.voice__check');

      checks.forEach((check) => {
        const prop = check.dataset.prop; // 'frac' | 'tnum'
        const target = prop === 'frac' ? recipe : column;
        const sync = () => {
          if (target && prop) target.dataset[prop] = check.checked ? 'on' : 'off';
        };
        check.addEventListener('change', sync);
        sync();
      });
    });
  }

  document.addEventListener('astro:page-load', bind);
</script>
