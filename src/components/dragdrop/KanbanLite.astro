---
/* ─────────────────────────────────────────────────────────────
   KanbanLite — spostare una card tra due colonne, col mouse e con
   le frecce, e farle ricomporre con FLIP.

   La kanban è il drag-and-drop più inaccessibile che esista: quasi
   sempre è solo-mouse, e una scheda "bloccata" in una colonna è una
   scheda persa per chi naviga da tastiera. Qui teniamo la versione
   minima — due colonne, "Da fare" e "Fatto" — ma con entrambe le
   strade complete.

   Puntatore: prendi una card, sorvola una colonna (che si illumina)
   e rilascia. Tastiera: dai il focus alla card e premi ←/→ per
   mandarla nella colonna a sinistra o a destra; ogni spostamento è
   annunciato via aria-live ("spostata in Fatto"). La colonna non è
   distinta solo dal colore: ha un titolo e un conteggio, e quando è
   bersaglio mostra un bordo pieno, non solo una tinta.

   Il ricomporsi delle due colonne — la card che esce da una e la
   coda che si richiude, la card che entra nell’altra e le sorelle
   che le fanno spazio — usa FLIP, misurando la geometria prima e
   dopo lo spostamento DOM. Guardato da matchMedia: sotto
   prefers-reduced-motion la card si trova già nella nuova colonna,
   senza viaggio. Pointer Events, niente drag-image del browser;
   bind idempotente; teardown dei listener su astro:before-swap.
   ───────────────────────────────────────────────────────────── */

interface Props {
  locale?: 'it' | 'en';
}
const { locale = 'it' } = Astro.props;

const COPY = {
  it: {
    hint: 'Trascina una card tra le colonne, oppure dai il focus e usa ←/→.',
    cols: [
      { id: 'todo', name: 'Da fare' },
      { id: 'done', name: 'Fatto' },
    ],
    count: 'card',
    move: 'Sposta la card',
    cards: [
      { col: 'todo', text: 'Scrivere il changelog' },
      { col: 'todo', text: 'Rivedere la PR #42' },
      { col: 'done', text: 'Aggiornare le dipendenze' },
    ],
    // {0}=card {1}=colonna
    moved: '{0}, spostata in “{1}”.',
    edge: '{0} è già nella colonna di bordo: non c’è una colonna oltre.',
  },
  en: {
    hint: 'Drag a card between columns, or focus it and use ←/→.',
    cols: [
      { id: 'todo', name: 'To do' },
      { id: 'done', name: 'Done' },
    ],
    count: 'cards',
    move: 'Move the card',
    cards: [
      { col: 'todo', text: 'Write the changelog' },
      { col: 'todo', text: 'Review PR #42' },
      { col: 'done', text: 'Update dependencies' },
    ],
    moved: '{0}, moved to “{1}”.',
    edge: '{0} is already in the edge column: there’s no column beyond.',
  },
} as const;
const c = COPY[locale];
const cardsByCol = (id: string) => c.cards.filter((x) => x.col === id);
---

<div
  class="kan"
  data-count={c.count}
  data-msg-moved={c.moved}
  data-msg-edge={c.edge}
>
  <span class="kan__hint">{c.hint}</span>

  <div class="kan__board">
    {c.cols.map((col) => (
      <section class="kan__col" data-col={col.id} aria-label={col.name}>
        <header class="kan__col-head">
          <span class="kan__col-name">{col.name}</span>
          <span class="kan__col-count tabular" data-count-for={col.id}>
            {cardsByCol(col.id).length} {c.count}
          </span>
        </header>
        <ul class="kan__cards" role="list">
          {cardsByCol(col.id).map((card) => (
            <li
              class="kan__card"
              tabindex="0"
              role="button"
              aria-label={`${c.move}: ${card.text}`}
            >
              <span class="kan__grip" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none">
                  <circle cx="6" cy="5" r="1.1" fill="currentColor" />
                  <circle cx="10" cy="5" r="1.1" fill="currentColor" />
                  <circle cx="6" cy="11" r="1.1" fill="currentColor" />
                  <circle cx="10" cy="11" r="1.1" fill="currentColor" />
                </svg>
              </span>
              <span class="kan__card-text">{card.text}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <span class="kan__live" role="status" aria-live="polite"></span>
</div>

<style>
  .kan {
    inline-size: min(34rem, 100%);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .kan__hint { font-size: var(--text-xs); color: var(--ink-muted); }

  .kan__board {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
    align-items: start;
  }

  .kan__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-2xs);
    border-radius: var(--radius-lg);
    border: 1.5px dashed transparent;
    background-color: var(--surface-sunken);
    transition: border-color var(--dur-fast) var(--ease-out-soft),
      background-color var(--dur-fast) var(--ease-out-soft);
  }
  .kan__col[data-over] {
    border-color: var(--accent);
    background-color: var(--accent-soft);
  }

  .kan__col-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--space-2xs) 0;
  }
  .kan__col-name {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--ink-muted);
  }
  .kan__col-count { font-size: var(--text-2xs); color: var(--ink-subtle); }

  .kan__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    min-block-size: 3rem;
  }

  .kan__card {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-md);
    background-color: var(--surface-raised);
    border: 1px solid var(--border);
    color: var(--ink);
    font-size: var(--text-sm);
    cursor: grab;
    touch-action: none;
    will-change: transform;
    transition: box-shadow var(--dur-fast) var(--ease-out-soft);
  }
  .kan__card:focus-visible {
    outline: none;
    box-shadow: var(--halo-focus);
    border-color: var(--accent);
  }
  .kan__card[data-lift] {
    position: relative;
    z-index: var(--z-raised);
    cursor: grabbing;
    border-color: var(--accent);
    box-shadow: var(--shadow-lg);
    transform: translate(var(--dx, 0), var(--dy, 0)) scale(1.03);
    transition: none;
  }

  .kan__grip { display: inline-flex; color: var(--ink-subtle); flex-shrink: 0; }
  .kan__grip svg { inline-size: 0.9rem; block-size: 0.9rem; }
  .kan__card-text { flex: 1; }

  .kan__live {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  type Cleanup = () => void;

  const fmt = (t: string, ...a: string[]) =>
    t.replace(/\{(\d+)\}/g, (_, n) => a[Number(n)] ?? '');

  function bind() {
    document.querySelectorAll<HTMLElement>('.kan').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      const board = root.querySelector<HTMLElement>('.kan__board');
      const live = root.querySelector<HTMLElement>('.kan__live');
      if (!board || !live) return;

      const countWord = root.dataset.count ?? '';
      const msgMoved = root.dataset.msgMoved ?? '';
      const msgEdge = root.dataset.msgEdge ?? '';

      const reduce = () =>
        window.matchMedia?.('(prefers-reduced-motion: reduce)').matches === true;

      const cols = Array.from(board.querySelectorAll<HTMLElement>('.kan__col'));
      const listOf = (col: HTMLElement) =>
        col.querySelector<HTMLElement>('.kan__cards')!;
      const allCards = () =>
        Array.from(board.querySelectorAll<HTMLElement>('.kan__card'));
      const textOf = (el: HTMLElement) =>
        el.querySelector('.kan__card-text')?.textContent?.trim() ?? '';
      const announce = (s: string) => { live.textContent = s; };

      const refreshCounts = () => {
        cols.forEach((col) => {
          const n = listOf(col).querySelectorAll('.kan__card').length;
          const out = col.querySelector<HTMLElement>('.kan__col-count');
          if (out) out.textContent = `${n} ${countWord}`;
        });
      };

      // FLIP su tutte le card delle due colonne (la coda si richiude di
      // qua, le sorelle fanno spazio di là). Guardato da matchMedia.
      const flip = (mutate: () => void) => {
        const els = allCards();
        if (reduce()) { mutate(); return; }
        const first = new Map<HTMLElement, DOMRect>();
        els.forEach((el) => first.set(el, el.getBoundingClientRect()));
        mutate();
        allCards().forEach((el) => {
          const b = first.get(el);
          if (!b) return; // card nuova: niente FLIP
          const a = el.getBoundingClientRect();
          const dx = b.left - a.left;
          const dy = b.top - a.top;
          if (!dx && !dy) return;
          el.style.transition = 'none';
          el.style.transform = `translate(${dx}px, ${dy}px)`;
          requestAnimationFrame(() => {
            el.style.transition = `transform var(--dur-normal) var(--ease-out-soft)`;
            el.style.transform = '';
          });
        });
      };

      const colIndexOf = (card: HTMLElement) =>
        cols.findIndex((col) => col.contains(card));

      const moveToCol = (card: HTMLElement, target: HTMLElement, focus: boolean) => {
        flip(() => listOf(target).appendChild(card));
        refreshCounts();
        if (focus) card.focus();
        const name = target.getAttribute('aria-label') ?? '';
        announce(fmt(msgMoved, textOf(card), name));
      };

      // ── Tastiera: ←/→ tra colonne ──
      board.addEventListener('keydown', (e: KeyboardEvent) => {
        const card = (e.target as HTMLElement)?.closest<HTMLElement>('.kan__card');
        if (!card) return;
        let dir = 0;
        if (e.key === 'ArrowLeft') dir = -1;
        else if (e.key === 'ArrowRight') dir = 1;
        else return;
        e.preventDefault();
        const at = colIndexOf(card);
        const to = at + dir;
        if (to < 0 || to >= cols.length) {
          announce(fmt(msgEdge, textOf(card)));
          return;
        }
        moveToCol(card, cols[to], true);
      });

      // ── Puntatore: trascina e rilascia sulla colonna ──
      let dragging: HTMLElement | null = null;
      let startX = 0;
      let startY = 0;
      let overCol: HTMLElement | null = null;

      const colUnder = (x: number, y: number): HTMLElement | null => {
        for (const col of cols) {
          const r = col.getBoundingClientRect();
          if (x >= r.left && x <= r.right && y >= r.top && y <= r.bottom) return col;
        }
        return null;
      };

      const onMove = (e: PointerEvent) => {
        if (!dragging) return;
        dragging.style.setProperty('--dx', `${e.clientX - startX}px`);
        dragging.style.setProperty('--dy', `${e.clientY - startY}px`);
        const col = colUnder(e.clientX, e.clientY);
        if (col !== overCol) {
          if (overCol) delete overCol.dataset.over;
          overCol = col;
          if (overCol) overCol.dataset.over = '';
        }
      };

      const endDrag = (e: PointerEvent) => {
        if (!dragging) return;
        const card = dragging;
        document.removeEventListener('pointermove', onMove);
        document.removeEventListener('pointerup', endDrag);
        document.removeEventListener('pointercancel', endDrag);
        try { card.releasePointerCapture(e.pointerId); } catch {}
        card.style.removeProperty('--dx');
        card.style.removeProperty('--dy');
        delete card.dataset.lift;
        const target = overCol;
        if (overCol) { delete overCol.dataset.over; overCol = null; }
        dragging = null;
        if (target && !target.contains(card)) moveToCol(card, target, false);
      };

      board.addEventListener('pointerdown', (e: PointerEvent) => {
        if (e.button !== 0) return;
        const card = (e.target as HTMLElement)?.closest<HTMLElement>('.kan__card');
        if (!card) return;
        e.preventDefault();
        dragging = card;
        startX = e.clientX;
        startY = e.clientY;
        card.dataset.lift = '';
        try { card.setPointerCapture(e.pointerId); } catch {}
        document.addEventListener('pointermove', onMove);
        document.addEventListener('pointerup', endDrag);
        document.addEventListener('pointercancel', endDrag);
      });

      const cleanup: Cleanup = () => {
        document.removeEventListener('pointermove', onMove);
        document.removeEventListener('pointerup', endDrag);
        document.removeEventListener('pointercancel', endDrag);
      };
      document.addEventListener('astro:before-swap', cleanup, { once: true });
    });
  }

  document.addEventListener('astro:page-load', bind);
</script>
