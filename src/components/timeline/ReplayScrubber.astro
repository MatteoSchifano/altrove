---
/* ─────────────────────────────────────────────────────────────
   ReplayScrubber — il tempo come cosa che si trascina.

   A volte la timeline non si guarda: si *manovra*. Lo scrubber è il
   tempo reso afferrabile — trascini il cursore e rivedi lo stato del
   sistema a quell’istante. È la differenza fra leggere un log e
   riavvolgere un nastro: il tempo diventa una dimensione che hai in
   mano.

   Il cuore è un <input type="range"> vero, non un <div> con dei
   listener. Perché:
     • la tastiera arriva gratis — ←/→ scrubbano di uno step, Home/End
       saltano agli estremi;
     • il browser gestisce trascinamento, touch, focus;
     • basta dichiarare min/max/step e la semantica c’è.
   L’unica cosa che aggiungiamo è aria-valuetext: senza, lo screen
   reader leggerebbe "3 di 5" (un numero muto); con, legge "Sep 16,
   build verde" — il *significato* di quel momento, non il suo indice.

   Onestà dei dati: ogni fotogramma è uno stato di campione vero e
   fisso (data + esito). Niente new Date() nel build; lo stato attivo
   lo sceglie il client leggendo l’indice dello slider.

   Reduced motion: lo scrubbing è guidato dall’utente, non è un’auto-
   animazione — non c’è nulla da "togliere". L’unica transizione
   (l’evidenziazione del frame) collassa a 1ms via i token.
   ───────────────────────────────────────────────────────────── */

interface Props {
  locale?: 'it' | 'en';
}
const { locale = 'it' } = Astro.props;

type Outcome = 'pass' | 'fail' | 'pending';

interface Frame {
  iso: string;
  label: string;
  outcome: Outcome;
  note: string;
}

const COPY = {
  it: {
    heading: 'Riavvolgi la pipeline',
    hint: 'Trascina, o usa le frecce, per rivedere lo stato a quel momento.',
    outcomes: { pass: 'verde', fail: 'rosso', pending: 'in corso' } as Record<Outcome, string>,
    frames: [
      { iso: '2026-09-14', label: '14 set', outcome: 'pending', note: 'Primo push, pipeline avviata.' },
      { iso: '2026-09-15', label: '15 set', outcome: 'fail', note: 'Test di accessibilità fallito.' },
      { iso: '2026-09-16', label: '16 set', outcome: 'pass', note: 'Corretto: tutti i test verdi.' },
      { iso: '2026-09-17', label: '17 set', outcome: 'pass', note: 'Merge nel ramo principale.' },
      { iso: '2026-09-18', label: '18 set', outcome: 'pass', note: 'Rilascio in produzione.' },
    ] as Frame[],
    valuetext: (label: string, outcome: string) => `${label}, build ${outcome}`,
  },
  en: {
    heading: 'Replay the pipeline',
    hint: 'Drag, or use the arrows, to review the state at that moment.',
    outcomes: { pass: 'green', fail: 'red', pending: 'in progress' } as Record<Outcome, string>,
    frames: [
      { iso: '2026-09-14', label: 'Sep 14', outcome: 'pending', note: 'First push, pipeline started.' },
      { iso: '2026-09-15', label: 'Sep 15', outcome: 'fail', note: 'Accessibility test failed.' },
      { iso: '2026-09-16', label: 'Sep 16', outcome: 'pass', note: 'Fixed: all tests green.' },
      { iso: '2026-09-17', label: 'Sep 17', outcome: 'pass', note: 'Merged into the main branch.' },
      { iso: '2026-09-18', label: 'Sep 18', outcome: 'pass', note: 'Shipped to production.' },
    ] as Frame[],
    valuetext: (label: string, outcome: string) => `${label}, build ${outcome}`,
  },
} as const;
const c = COPY[locale];
const last = c.frames.length - 1;
const sliderId = `scrub-${locale}`;
const initial = last; // si apre sull’ultimo stato, il "presente"

const framesData = c.frames.map((f) => ({
  iso: f.iso,
  label: f.label,
  outcome: f.outcome, // chiave stabile (pass/fail/pending) per glifo + tinta
  outcomeText: c.outcomes[f.outcome], // parola localizzata, leggibile
  note: f.note,
}));
const init = c.frames[initial];
---

<section class="sc" aria-label={c.heading}>
  <h4 class="sc__heading">{c.heading}</h4>

  {/* Il fotogramma corrente: data + esito + nota. role=status così i
      cambi di stato durante lo scrub vengono annunciati con garbo. */}
  <div class="sc__frame" role="status" aria-live="polite">
    <div class="sc__frame-head">
      <time class="sc__date tabular" datetime={init.iso} data-frame-date>{init.label}</time>
      <span class="sc__outcome" data-outcome={init.outcome} data-frame-outcome>
        {c.outcomes[init.outcome]}
      </span>
    </div>
    <p class="sc__note" data-frame-note>{init.note}</p>
  </div>

  {/* I segni-tappa sotto allo slider: una pista visiva del nastro. */}
  <ol class="sc__ticks" role="list">
    {c.frames.map((f, i) => (
      <li class="sc__tick" data-outcome={f.outcome} data-active={i === initial ? 'true' : undefined}>
        <span class="sc__tick-dot" aria-hidden="true"></span>
      </li>
    ))}
  </ol>

  <input
    type="range"
    class="sc__range"
    id={sliderId}
    min="0"
    max={String(last)}
    step="1"
    value={String(initial)}
    aria-label={c.heading}
    aria-valuetext={c.valuetext(init.label, c.outcomes[init.outcome])}
    data-frames={JSON.stringify(framesData)}
  />

  <p class="sc__hint" id={`${sliderId}-hint`}>{c.hint}</p>
</section>

<style>
  .sc {
    inline-size: min(30rem, 100%);
    background-color: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-md) var(--space-lg);
  }

  .sc__heading {
    margin: 0 0 var(--space-sm);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--ink-strong);
    letter-spacing: var(--tracking-snug);
  }

  .sc__frame {
    background-color: var(--surface-sunken);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-md);
    margin-block-end: var(--space-md);
    min-block-size: 4.5rem;
  }
  .sc__frame-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
  }
  .sc__date {
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    color: var(--ink-strong);
    letter-spacing: var(--tracking-snug);
  }

  /* Esito: il colore è il secondo segnale; il primo è la parola
     ("verde"/"rosso") e il glifo davanti. */
  .sc__outcome {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  /* I tre esiti si distinguono per GLIFO, non solo per tinta. */
  .sc__outcome::before { margin-inline-end: 0.3rem; }
  .sc__outcome[data-outcome='pass'] { color: var(--accent-ink); }
  .sc__outcome[data-outcome='pass']::before { content: '✓'; }
  .sc__outcome[data-outcome='fail'] { color: var(--accent-ink); }
  .sc__outcome[data-outcome='fail']::before { content: '✕'; }
  .sc__outcome[data-outcome='pending'] { color: var(--ink-muted); }
  .sc__outcome[data-outcome='pending']::before { content: '◔'; }

  .sc__note {
    margin: 0.4rem 0 0;
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: var(--leading-relaxed);
  }

  /* La pista di segni: un puntino per fotogramma, allineato allo slider. */
  .sc__ticks {
    list-style: none;
    margin: 0 0 0.3rem;
    padding: 0 0.6rem;
    display: flex;
    justify-content: space-between;
  }
  .sc__tick-dot {
    display: block;
    inline-size: 0.55rem;
    block-size: 0.55rem;
    border-radius: 50%;
    background-color: var(--border-strong);
    transition: transform var(--dur-fast) var(--ease-out-snug),
                background-color var(--dur-fast) var(--ease-out-soft);
  }
  .sc__tick[data-outcome='pass'] .sc__tick-dot { background-color: var(--accent); }
  .sc__tick[data-outcome='fail'] .sc__tick-dot {
    background-color: var(--surface-raised);
    border: 2px solid var(--accent-ink);
    inline-size: 0.6rem;
    block-size: 0.6rem;
  }
  .sc__tick[data-active] .sc__tick-dot { transform: scale(1.5); }

  /* Lo slider: stile minimo ma con un thumb afferrabile e un anello
     di focus onesto. */
  .sc__range {
    inline-size: 100%;
    margin: 0;
    accent-color: var(--accent);
    cursor: pointer;
  }
  .sc__range:focus-visible {
    outline: none;
    border-radius: var(--radius-pill);
    box-shadow: var(--halo-focus);
  }

  .sc__hint {
    margin: var(--space-2xs) 0 0;
    font-size: var(--text-2xs);
    color: var(--ink-subtle);
  }

  .sc__date,
  .sc__outcome,
  .sc__note {
    transition: opacity var(--dur-fast) var(--ease-out-soft);
  }
</style>

<script>
  interface FrameData {
    iso: string;
    label: string;
    outcome: string; // chiave: pass/fail/pending
    outcomeText: string; // parola localizzata
    note: string;
  }

  function bind() {
    document.querySelectorAll<HTMLElement>('.sc').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      const range = root.querySelector<HTMLInputElement>('.sc__range');
      if (!range) return;

      let frames: FrameData[] = [];
      try {
        frames = JSON.parse(range.dataset.frames ?? '[]') as FrameData[];
      } catch {
        frames = [];
      }
      if (frames.length === 0) return;

      const dateEl = root.querySelector<HTMLTimeElement>('[data-frame-date]');
      const outcomeEl = root.querySelector<HTMLElement>('[data-frame-outcome]');
      const noteEl = root.querySelector<HTMLElement>('[data-frame-note]');
      const ticks = root.querySelectorAll<HTMLElement>('.sc__tick');

      const render = (index: number) => {
        const f = frames[index];
        if (!f) return;

        if (dateEl) {
          dateEl.textContent = f.label;
          dateEl.setAttribute('datetime', f.iso);
        }
        if (outcomeEl) {
          outcomeEl.textContent = f.outcomeText;
          outcomeEl.dataset.outcome = f.outcome;
        }
        if (noteEl) noteEl.textContent = f.note;

        // aria-valuetext leggibile: il SIGNIFICATO del momento, non
        // l’indice grezzo. Lo screen reader legge "Sep 16, build green".
        range.setAttribute('aria-valuetext', `${f.label}, build ${f.outcomeText}`);

        ticks.forEach((tick, i) => {
          if (i === index) tick.dataset.active = 'true';
          else delete tick.dataset.active;
        });
      };

      range.addEventListener('input', () => {
        render(range.valueAsNumber);
      });
    });
  }

  document.addEventListener('astro:page-load', bind);
</script>
