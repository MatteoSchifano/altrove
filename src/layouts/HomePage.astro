---
/* ─────────────────────────────────────────────────────────────
   HomePage.astro — la landing dell'Atelier, riusata per ogni locale.

   Le pagine pages/index.astro e pages/en/index.astro sono
   wrapper di una riga su questo layout, passando solo la locale.
   Tutta la logica vive qui per evitare divergenze tra le versioni.

   Architettura della pagina (sette famiglie di layout distinte,
   con un aggancio visivo in ogni fascia — l'occhio non riposa mai
   su solo testo):
   1. Hero        — split asimmetrico: copy + uno specimen vivo.
   2. Statement   — pull-quote full-width, il pensiero del progetto.
   3. Skill       — terminale a sinistra, copy a destra (alterna il hero).
   4. Principi    — bento asimmetrico: vincoli di lavoro + demo vive
                    dei capitoli (bottone, skeleton, toggle) annotate.
   5. Capitoli    — griglia di ChapterCard (la signature interaction).
   6. Roadmap     — il percorso/timeline del libro.
   7. Colophon    — "cosa non è", in colonna singola, centrata.

   La scelta di NON usare fotografia stock è deliberata: l'asset
   onesto di Altrove è il suo stesso motion. Lo specimen nell'hero
   è un componente reale (magnetic + soft-press), non un mockup.
   ───────────────────────────────────────────────────────────── */

import Base from './Base.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import LanguageToggle from '../components/LanguageToggle.astro';
import ChapterCard from '../components/ChapterCard.astro';
import RoadmapSection from '../components/RoadmapSection.astro';
import SkillInstall from '../components/SkillInstall.astro';
import { getReleasedChapters } from '../lib/chapters';
import { t, localizedPath, getOtherLocales, type Locale } from '../lib/i18n';
import { resolveReadingTime } from '../lib/readingTime';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const alternateLocale = getOtherLocales(locale)[0]!;
const alternateHref = localizedPath('/', alternateLocale);
const homeHref = localizedPath('/', locale);

const SOURCE_URL = 'https://github.com/MatteoSchifano/altrove';

/** Spoglia il prefisso locale dall'id della collection per ottenere
    lo slug puro (usato per URL e view-transition-name). */
function slugOf(id: string, lang: Locale): string {
  return id.startsWith(`${lang}/`) ? id.slice(lang.length + 1) : id;
}

const chapters = (await getReleasedChapters((data) => data.lang === locale))
  .sort((a, b) => Number(a.data.number) - Number(b.data.number));

/* I quattro principi — testo da i18n, struttura qui per il bento. */
const principles = [
  { n: '01', title: t('home.principle1Title', locale), body: t('home.principle1Body', locale) },
  { n: '02', title: t('home.principle2Title', locale), body: t('home.principle2Body', locale) },
  { n: '03', title: t('home.principle3Title', locale), body: t('home.principle3Body', locale) },
  { n: '04', title: t('home.principle4Title', locale), body: t('home.principle4Body', locale) },
];

const notList = [
  t('home.notA1', locale),
  t('home.notA2', locale),
  t('home.notA3', locale),
  t('home.notA4', locale),
];

/* Il punto finale di "Altrove." è la voce del marchio: lo isoliamo
   per dargli il colore dell'accent (lo stesso del wordmark__dot). */
const rawTitle = t('home.title', locale);
const titleHasDot = rawTitle.endsWith('.');
const titleText = titleHasDot ? rawTitle.slice(0, -1) : rawTitle;
---

<Base
  locale={locale}
  alternateLocale={alternateLocale}
  alternateHref={alternateHref}
>
  <div class="page">
    <header class="site-header">
      <div class="container site-header__row">
        <a class="wordmark" href={homeHref} aria-label={t('header.homeLabel', locale)}>
          <span class="wordmark__dot" aria-hidden="true"></span>
          <span class="wordmark__name">Altrove</span>
        </a>
        <nav class="site-nav">
          <LanguageToggle
            currentLocale={locale}
            alternateLocale={alternateLocale}
            alternateHref={alternateHref}
          />
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <main>
      {/* ─── 1 · Hero: split asimmetrico copy + specimen ─── */}
      <section class="hero" data-hero>
        <div class="grain" aria-hidden="true"></div>
        <div class="container hero__grid">
          <div class="hero__copy">
            <p class="eyebrow hero__eyebrow">{t('home.eyebrow', locale)}</p>
            <h1
              class="display hero__title"
              data-motion="text"
              data-text-unit="char"
              data-text-preset="expressive"
              data-text-stagger="46"
              data-text-rise="44"
              data-text-gate="entrance"
            >
              {titleText}{titleHasDot && <span class="hero__title-dot" data-tr-whole="true">.</span>}
            </h1>
            <p class="hero__lede">{t('home.lede', locale)}</p>
            <p class="hero__manifesto">
              {t('home.manifestoBefore', locale)}<em>{t('home.manifestoEm', locale)}</em>{t('home.manifestoAfter', locale)}
            </p>
            <div class="hero__cta cluster">
              <a class="btn btn--solid" href="#capitoli">
                <span class="btn__face">{t('home.ctaRead', locale)}</span>
              </a>
              <a class="btn btn--ghost" href={SOURCE_URL} rel="noopener" target="_blank">
                <span class="btn__face">
                  {t('home.ctaSource', locale)}
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 11L11 5M11 5H6M11 5V10" />
                  </svg>
                </span>
              </a>
            </div>
          </div>

          {/* Specimen vivo: il pannello è magnetic, il bottone dentro
              è un soft-press reale. Due pattern del progetto, onesti. */}
          <aside
            class="specimen"
            data-motion="magnetic"
            data-strength="0.12"
            data-preset="gentle"
            aria-label={t('home.specLabel', locale)}
          >
            <div class="specimen__bar">
              <span class="specimen__dots" aria-hidden="true">
                <i></i><i></i><i></i>
              </span>
              <span class="specimen__label">{t('home.specLabel', locale)}</span>
            </div>
            <div class="specimen__stage">
              <button class="soft-press" type="button">
                <span class="soft-press__face">{t('home.specButton', locale)}</span>
              </button>
              <p class="specimen__caption">{t('home.specCaption', locale)}</p>
            </div>
            <div class="specimen__meta">
              <span class="specimen__chip">{t('home.specMetaA', locale)}</span>
              <span class="specimen__chip">{t('home.specMetaB', locale)}</span>
            </div>
          </aside>
        </div>
      </section>

      {/* Cascata d'ingresso del hero: solo alla prima visita della
          sessione — le pagine che ri-animano sembrano nervose; questa
          anima una volta. Senza JS l'attributo non viene mai messo e
          il hero è semplicemente visibile. */}
      <script is:inline data-astro-rerun>
        (() => {
          try {
            if (sessionStorage.getItem('altrove-entrance') === 'done') return;
            sessionStorage.setItem('altrove-entrance', 'done');
            document.querySelector('[data-hero]')?.setAttribute('data-entrance', 'play');
          } catch (_) {
            /* sessionStorage bloccato: meglio nessuna cascata che una a ogni nav */
          }
        })();
      </script>

      {/* ─── 2 · Statement: pull-quote full-width ─── */}
      <section class="statement">
        <div class="container">
          <p
            class="statement__text"
            data-motion="text"
            data-text-unit="word"
            data-text-preset="gentle"
            data-text-stagger="36"
            data-text-rise="16"
          >
            {t('home.statementLead', locale)}<em>{t('home.statementEm', locale)}</em>{t('home.statementTail', locale)}
          </p>
        </div>
      </section>

      {/* ─── 3 · La skill: porta il libro nel tuo agente ─── */}
      <SkillInstall locale={locale} />

      {/* ─── 4 · Principi: bento asimmetrico con demo vive ───
          I quattro vincoli si alternano a tre vignette animate prese
          dai capitoli: un bottone che si preme, uno skeleton che
          attende, un toggle che scatta — annotati coi numeri veri. */}
      <section class="principles">
        <div class="container">
          <header class="principles__head" data-reveal>
            <p class="eyebrow">{t('home.principlesEyebrow', locale)}</p>
            <h2 class="principles__title">{t('home.principlesTitle', locale)}</h2>
          </header>
          <ul role="list" class="principles__grid">
            <li class="pcell pcell--1" data-reveal>
              <span class="pcell__num tabular" aria-hidden="true">{principles[0].n}</span>
              <h3 class="pcell__title">{principles[0].title}</h3>
              <p class="pcell__body">{principles[0].body}</p>
            </li>

            <li class="dcell" data-reveal>
              <span class="dcell__kicker">{t('demo.cap01', locale)}</span>
              <span class="dcell__stage">
                <span class="demo-press">{t('demo.button', locale)}</span>
              </span>
              <span class="dcell__note">{t('demo.notePress', locale)}</span>
            </li>

            <li class="pcell pcell--2" data-reveal>
              <span class="pcell__num tabular" aria-hidden="true">{principles[1].n}</span>
              <h3 class="pcell__title">{principles[1].title}</h3>
              <p class="pcell__body">{principles[1].body}</p>
            </li>

            <li class="dcell" data-reveal>
              <span class="dcell__kicker">{t('demo.cap02', locale)}</span>
              <span class="dcell__stage dcell__stage--skeleton" aria-hidden="true">
                <span class="demo-skel demo-skel--avatar"></span>
                <span class="demo-skel demo-skel--line demo-skel--w1"></span>
                <span class="demo-skel demo-skel--line demo-skel--w2"></span>
              </span>
              <span class="dcell__note">{t('demo.noteWait', locale)}</span>
            </li>

            <li class="pcell pcell--3" data-reveal>
              <span class="pcell__num tabular" aria-hidden="true">{principles[2].n}</span>
              <h3 class="pcell__title">{principles[2].title}</h3>
              <p class="pcell__body">{principles[2].body}</p>
            </li>

            <li class="dcell" data-reveal>
              <span class="dcell__kicker">{t('demo.cap09', locale)}</span>
              <span class="dcell__stage">
                <span class="demo-toggle" aria-hidden="true">
                  <span class="demo-toggle__knob"></span>
                </span>
                <span class="demo-toggle__label">{t('demo.toggleLabel', locale)}</span>
              </span>
              <span class="dcell__note">{t('demo.noteToggle', locale)}</span>
            </li>

            <li class="pcell pcell--4" data-reveal>
              <span class="pcell__num tabular" aria-hidden="true">{principles[3].n}</span>
              <h3 class="pcell__title">{principles[3].title}</h3>
              <p class="pcell__body">{principles[3].body}</p>
            </li>
          </ul>
        </div>
      </section>

      {/* ─── 5 · Capitoli: la griglia signature ─── */}
      <section class="chapters" id="capitoli">
        <div class="container">
          <header class="chapters__head" data-reveal>
            <h2 class="chapters__title">{t('home.chaptersTitle', locale)}</h2>
            <p class="chapters__hint">
              <span class="chapters__count tabular">{chapters.length}</span>
              <span>{chapters.length === 1 ? t('home.chaptersHintOne', locale) : t('home.chaptersHintMany', locale)}</span>
            </p>
          </header>

          <ul role="list" class="chapters__grid">
            {chapters.map((c) => {
              const slug = slugOf(c.id, locale);
              const readMinutes = resolveReadingTime(c.body, c.data.readMinutes);
              return (
                <li data-reveal>
                  <ChapterCard
                    locale={locale}
                    number={c.data.number}
                    title={c.data.title}
                    excerpt={c.data.excerpt}
                    href={localizedPath(`/chapters/${slug}`, locale)}
                    date={c.data.date}
                    readMinutes={readMinutes}
                    slug={slug}
                  />
                </li>
              );
            })}
          </ul>
        </div>
      </section>

      {/* ─── 6 · Roadmap: il percorso del libro ─── */}
      <RoadmapSection locale={locale} publishedChapters={chapters} />

      {/* ─── 7 · Colophon: "cosa non è", colonna singola ─── */}
      <section class="colophon">
        <div class="container colophon__inner" data-reveal>
          <h2 class="colophon__title">{t('home.colophonTitle', locale)}</h2>
          <ul role="list" class="colophon__list">
            {notList.map((line) => (
              <li class="colophon__item">{line}</li>
            ))}
          </ul>
          <p class="colophon__stack">{t('home.stackNote', locale)}</p>
          <a class="btn btn--solid colophon__cta" href="#capitoli">
            <span class="btn__face">{t('home.ctaRead', locale)}</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container site-footer__row">
        <p class="site-footer__sig">{t('footer.signature', locale)}</p>
        <p class="site-footer__year tabular">{t('footer.year', locale)}</p>
      </div>
    </footer>
  </div>
</Base>

<style>
  /* ─── Header ─── */
  .site-header {
    padding-block: var(--space-md);
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-overlay);
    background-color: var(--surface-overlay);
    backdrop-filter: blur(12px) saturate(1.2);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    border-block-end: 1px solid var(--border);
  }

  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .site-nav {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    text-decoration: none;
    color: var(--ink-strong);
    font-weight: var(--weight-medium);
    font-size: var(--text-md);
    letter-spacing: var(--tracking-snug);
  }

  .wordmark__dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background-color: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 18%, transparent);
    transition: box-shadow var(--dur-normal) var(--ease-out-soft);
  }

  .wordmark:hover .wordmark__dot {
    box-shadow: 0 0 0 6px color-mix(in oklab, var(--accent) 22%, transparent);
  }

  /* ─── Bottoni condivisi (solid + ghost) ─── */
  .btn {
    --y-rest: 0;
    position: relative;
    display: inline-grid;
    place-items: center;
    padding: 0.875rem 1.5rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
    text-decoration: none;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform var(--dur-fast) var(--ease-out-snappy),
      box-shadow var(--dur-fast) var(--ease-out-soft),
      background-color var(--dur-fast) var(--ease-out-soft),
      border-color var(--dur-fast) var(--ease-out-soft),
      color var(--dur-fast) var(--ease-out-soft);
  }

  .btn__face {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .btn__face svg {
    inline-size: 0.85em;
    block-size: 0.85em;
  }

  .btn--solid {
    background-color: var(--accent);
    color: var(--accent-on);
    box-shadow: var(--shadow-md);
  }
  .btn--solid:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: var(--shadow-lg);
    background-color: color-mix(in oklab, var(--accent) 92%, white);
  }
  .btn--solid:active {
    transform: translateY(1px) scale(0.97);
    box-shadow: var(--shadow-pressed);
    transition-duration: 60ms;
  }
  .btn--solid:focus-visible {
    outline: none;
    box-shadow: var(--shadow-md), var(--halo-focus);
  }

  .btn--ghost {
    background-color: transparent;
    color: var(--ink);
    border: 1px solid var(--border-strong);
  }
  .btn--ghost:hover {
    transform: translateY(-2px);
    border-color: var(--ink-muted);
    color: var(--ink-strong);
    background-color: var(--surface);
  }
  .btn--ghost:active {
    transform: translateY(1px) scale(0.98);
    transition-duration: 60ms;
  }
  .btn--ghost:focus-visible {
    outline: none;
    box-shadow: var(--halo-focus);
  }

  /* ─── 1 · Hero ─── */
  .hero {
    position: relative;
    padding-block: var(--rhythm-loose) var(--rhythm);
    overflow: clip;
  }

  /* Luce ambientale: due aloni caldi quasi impercettibili, coerenti
     con il punto di luce dello specimen. Profondità, non gradiente. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        42rem 30rem at 82% 10%,
        color-mix(in oklab, var(--accent) 7%, transparent),
        transparent 65%
      ),
      radial-gradient(
        36rem 26rem at 6% 95%,
        color-mix(in oklab, var(--accent) 4%, transparent),
        transparent 70%
      );
    pointer-events: none;
  }

  .hero > .container { position: relative; }

  .hero__title-dot {
    color: var(--accent);
  }

  /* ─── Cascata d'ingresso — solo con [data-entrance='play'] ───
     70ms a passo (dentro la finestra 40–90ms), 640ms a elemento.
     fill backwards, non both: a fine corsa l'animazione si stacca
     e lascia il transform allo specimen magnetic. Il default senza
     attributo è tutto visibile: nessuna pagina vuota senza JS. */
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: none; }
  }

  .hero[data-entrance='play'] :is(.hero__eyebrow, .hero__lede, .hero__manifesto, .hero__cta) {
    animation: hero-rise 640ms var(--ease-out-soft) backwards;
  }
  /* Il titolo non usa la cascata CSS: lo compone Motion lettera per
     lettera (data-motion="text"). Qui lo teniamo solo nascosto fino
     al primo frame di quell'animazione, per non mostrarlo intero un
     istante prima dello split. Gated su no-preference E su
     data-entrance (settato SOLO da JS): con JS spento o reduced-motion
     l'attributo non c'è / la regola non si applica e il titolo è
     subito visibile. */
  @media (prefers-reduced-motion: no-preference) {
    .hero[data-entrance='play'] .hero__title { opacity: 0; }
  }
  .hero[data-entrance='play'] .hero__lede      { animation-delay: 140ms; }
  .hero[data-entrance='play'] .hero__manifesto { animation-delay: 210ms; }
  .hero[data-entrance='play'] .hero__cta       { animation-delay: 280ms; }
  .hero[data-entrance='play'] .specimen {
    animation: hero-rise 720ms var(--ease-out-soft) 220ms backwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero[data-entrance='play'] :is(.hero__eyebrow, .hero__title, .hero__lede, .hero__manifesto, .hero__cta),
    .hero[data-entrance='play'] .specimen {
      animation: none;
    }
  }

  .hero__grid {
    display: grid;
    gap: var(--space-2xl);
    grid-template-columns: 1fr;
    align-items: center;
  }

  @media (min-width: 60rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: var(--space-3xl);
    }
  }

  .hero__eyebrow {
    margin-block-end: var(--space-md);
  }

  .hero__title {
    margin-block-end: var(--space-md);
  }

  .hero__lede {
    font-size: var(--text-lg);
    color: var(--ink);
    max-inline-size: var(--measure);
    line-height: var(--leading-snug);
    margin-block-end: var(--space-md);
  }

  .hero__manifesto {
    color: var(--ink-muted);
    max-inline-size: var(--measure);
    line-height: var(--leading-relaxed);
    margin-block-end: var(--space-lg);
  }

  .hero__manifesto em {
    color: var(--accent-ink);
    font-style: normal;
    font-weight: var(--weight-medium);
  }

  .hero__cta {
    --cluster-gap: var(--space-sm);
  }

  /* ─── Specimen vivo ─── */
  .specimen {
    will-change: transform;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background-color: var(--surface-raised);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    justify-self: stretch;
  }

  .specimen__bar {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border-block-end: 1px solid var(--border);
    background-color: var(--surface);
  }

  .specimen__dots {
    display: inline-flex;
    gap: 0.375rem;
  }
  .specimen__dots i {
    inline-size: 0.6rem;
    block-size: 0.6rem;
    border-radius: 50%;
    background-color: var(--border-strong);
  }

  .specimen__label {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--ink-subtle);
    letter-spacing: var(--tracking-wide);
    text-transform: lowercase;
  }

  .specimen__stage {
    display: grid;
    place-items: center;
    gap: var(--space-md);
    padding: var(--space-2xl) var(--space-lg);
    text-align: center;
    /* punto di luce caldo, appena percepibile — niente piattume */
    background-image: radial-gradient(
       circle at 50% 38%,
      color-mix(in oklab, var(--accent) 9%, transparent),
      transparent 62%
    );
  }

  .specimen__caption {
    max-inline-size: 28ch;
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--ink-muted);
  }

  .specimen__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    padding: var(--space-sm) var(--space-md);
    border-block-start: 1px solid var(--border);
    background-color: var(--surface);
  }
  .specimen__chip {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--ink-muted);
    letter-spacing: var(--tracking-wide);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-xs);
    background-color: var(--surface-sunken);
    border: 1px solid var(--border);
  }

  /* Soft-press reale dentro lo specimen */
  .soft-press {
    position: relative;
    display: inline-grid;
    padding: 0.875rem 1.75rem;
    border-radius: var(--radius-pill);
    border: 0;
    background-color: var(--accent);
    color: var(--accent-on);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
