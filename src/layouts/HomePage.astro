---
/* ─────────────────────────────────────────────────────────────
   HomePage.astro — la landing dell'Atelier, riusata per ogni locale.

   Le pagine pages/index.astro e pages/en/index.astro sono
   wrapper di una riga su questo layout, passando solo la locale.
   Tutta la logica vive qui per evitare divergenze tra le versioni.

   Architettura della pagina (sei famiglie di layout distinte):
   1. Hero        — split asimmetrico: copy + uno specimen vivo.
   2. Statement   — pull-quote full-width, il pensiero del progetto.
   3. Principi    — bento asimmetrico, i pochi vincoli di lavoro.
   4. Capitoli    — griglia di ChapterCard (la signature interaction).
   5. Roadmap     — il percorso/timeline del libro.
   6. Colophon    — "cosa non è", in colonna singola, centrata.

   La scelta di NON usare fotografia stock è deliberata: l'asset
   onesto di Altrove è il suo stesso motion. Lo specimen nell'hero
   è un componente reale (magnetic + soft-press), non un mockup.
   ───────────────────────────────────────────────────────────── */

import Base from './Base.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import LanguageToggle from '../components/LanguageToggle.astro';
import ChapterCard from '../components/ChapterCard.astro';
import RoadmapSection from '../components/RoadmapSection.astro';
import { getReleasedChapters } from '../lib/chapters';
import { t, localizedPath, getOtherLocales, type Locale } from '../lib/i18n';
import { resolveReadingTime } from '../lib/readingTime';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const alternateLocale = getOtherLocales(locale)[0]!;
const alternateHref = localizedPath('/', alternateLocale);
const homeHref = localizedPath('/', locale);

const SOURCE_URL = 'https://github.com/MatteoSchifano/altrove';

/** Spoglia il prefisso locale dall'id della collection per ottenere
    lo slug puro (usato per URL e view-transition-name). */
function slugOf(id: string, lang: Locale): string {
  return id.startsWith(`${lang}/`) ? id.slice(lang.length + 1) : id;
}

const chapters = (await getReleasedChapters((data) => data.lang === locale))
  .sort((a, b) => Number(a.data.number) - Number(b.data.number));

/* I quattro principi — testo da i18n, struttura qui per il bento. */
const principles = [
  { n: '01', title: t('home.principle1Title', locale), body: t('home.principle1Body', locale) },
  { n: '02', title: t('home.principle2Title', locale), body: t('home.principle2Body', locale) },
  { n: '03', title: t('home.principle3Title', locale), body: t('home.principle3Body', locale) },
  { n: '04', title: t('home.principle4Title', locale), body: t('home.principle4Body', locale) },
];

const notList = [
  t('home.notA1', locale),
  t('home.notA2', locale),
  t('home.notA3', locale),
  t('home.notA4', locale),
];
---

<Base
  locale={locale}
  alternateLocale={alternateLocale}
  alternateHref={alternateHref}
>
  <div class="page">
    <header class="site-header">
      <div class="container site-header__row">
        <a class="wordmark" href={homeHref} aria-label={t('header.homeLabel', locale)}>
          <span class="wordmark__dot" aria-hidden="true"></span>
          <span class="wordmark__name">Altrove</span>
        </a>
        <nav class="site-nav">
          <LanguageToggle
            currentLocale={locale}
            alternateLocale={alternateLocale}
            alternateHref={alternateHref}
          />
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <main>
      {/* ─── 1 · Hero: split asimmetrico copy + specimen ─── */}
      <section class="hero">
        <div class="container hero__grid">
          <div class="hero__copy">
            <p class="eyebrow hero__eyebrow">{t('home.eyebrow', locale)}</p>
            <h1 class="display hero__title">{t('home.title', locale)}</h1>
            <p class="hero__lede">{t('home.lede', locale)}</p>
            <p class="hero__manifesto">
              {t('home.manifestoBefore', locale)}<em>{t('home.manifestoEm', locale)}</em>{t('home.manifestoAfter', locale)}
            </p>
            <div class="hero__cta cluster">
              <a class="btn btn--solid" href="#capitoli">
                <span class="btn__face">{t('home.ctaRead', locale)}</span>
              </a>
              <a class="btn btn--ghost" href={SOURCE_URL} rel="noopener" target="_blank">
                <span class="btn__face">
                  {t('home.ctaSource', locale)}
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 11L11 5M11 5H6M11 5V10" />
                  </svg>
                </span>
              </a>
            </div>
          </div>

          {/* Specimen vivo: il pannello è magnetic, il bottone dentro
              è un soft-press reale. Due pattern del progetto, onesti. */}
          <aside
            class="specimen"
            data-motion="magnetic"
            data-strength="0.12"
            data-preset="gentle"
            aria-label={t('home.specLabel', locale)}
          >
            <div class="specimen__bar">
              <span class="specimen__dots" aria-hidden="true">
                <i></i><i></i><i></i>
              </span>
              <span class="specimen__label">{t('home.specLabel', locale)}</span>
            </div>
            <div class="specimen__stage">
              <button class="soft-press" type="button">
                <span class="soft-press__face">{t('home.specButton', locale)}</span>
              </button>
              <p class="specimen__caption">{t('home.specCaption', locale)}</p>
            </div>
            <div class="specimen__meta">
              <span class="specimen__chip">{t('home.specMetaA', locale)}</span>
              <span class="specimen__chip">{t('home.specMetaB', locale)}</span>
            </div>
          </aside>
        </div>
      </section>

      {/* ─── 2 · Statement: pull-quote full-width ─── */}
      <section class="statement">
        <div class="container">
          <p class="statement__text">
            {t('home.statementLead', locale)}<em>{t('home.statementEm', locale)}</em>{t('home.statementTail', locale)}
          </p>
        </div>
      </section>

      {/* ─── 3 · Principi: bento asimmetrico ─── */}
      <section class="principles">
        <div class="container">
          <header class="principles__head">
            <p class="eyebrow">{t('home.principlesEyebrow', locale)}</p>
            <h2 class="principles__title">{t('home.principlesTitle', locale)}</h2>
          </header>
          <ul role="list" class="principles__grid">
            {principles.map((p, i) => (
              <li class={`pcell pcell--${i + 1}`}>
                <span class="pcell__num tabular" aria-hidden="true">{p.n}</span>
                <h3 class="pcell__title">{p.title}</h3>
                <p class="pcell__body">{p.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {/* ─── 4 · Capitoli: la griglia signature ─── */}
      <section class="chapters" id="capitoli">
        <div class="container">
          <header class="chapters__head">
            <h2 class="chapters__title">{t('home.chaptersTitle', locale)}</h2>
            <p class="chapters__hint">
              <span class="chapters__count tabular">{chapters.length}</span>
              <span>{chapters.length === 1 ? t('home.chaptersHintOne', locale) : t('home.chaptersHintMany', locale)}</span>
            </p>
          </header>

          <ul role="list" class="chapters__grid">
            {chapters.map((c) => {
              const slug = slugOf(c.id, locale);
              const readMinutes = resolveReadingTime(c.body, c.data.readMinutes);
              return (
                <li>
                  <ChapterCard
                    locale={locale}
                    number={c.data.number}
                    title={c.data.title}
                    excerpt={c.data.excerpt}
                    href={localizedPath(`/chapters/${slug}`, locale)}
                    date={c.data.date}
                    readMinutes={readMinutes}
                    slug={slug}
                  />
                </li>
              );
            })}
          </ul>
        </div>
      </section>

      {/* ─── 5 · Roadmap: il percorso del libro ─── */}
      <RoadmapSection locale={locale} publishedChapters={chapters} />

      {/* ─── 6 · Colophon: "cosa non è", colonna singola ─── */}
      <section class="colophon">
        <div class="container colophon__inner">
          <h2 class="colophon__title">{t('home.colophonTitle', locale)}</h2>
          <ul role="list" class="colophon__list">
            {notList.map((line) => (
              <li class="colophon__item">{line}</li>
            ))}
          </ul>
          <p class="colophon__stack">{t('home.stackNote', locale)}</p>
          <a class="btn btn--solid colophon__cta" href="#capitoli">
            <span class="btn__face">{t('home.ctaRead', locale)}</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container site-footer__row">
        <p class="site-footer__sig">{t('footer.signature', locale)}</p>
        <p class="site-footer__year tabular">{t('footer.year', locale)}</p>
      </div>
    </footer>
  </div>
</Base>

<style>
  /* ─── Header ─── */
  .site-header {
    padding-block: var(--space-md);
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-overlay);
    background-color: var(--surface-overlay);
    backdrop-filter: blur(12px) saturate(1.2);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    border-block-end: 1px solid var(--border);
  }

  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .site-nav {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    text-decoration: none;
    color: var(--ink-strong);
    font-weight: var(--weight-medium);
    font-size: var(--text-md);
    letter-spacing: var(--tracking-snug);
  }

  .wordmark__dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background-color: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 18%, transparent);
    transition: box-shadow var(--dur-normal) var(--ease-out-soft);
  }

  .wordmark:hover .wordmark__dot {
    box-shadow: 0 0 0 6px color-mix(in oklab, var(--accent) 22%, transparent);
  }

  /* ─── Bottoni condivisi (solid + ghost) ─── */
  .btn {
    --y-rest: 0;
    position: relative;
    display: inline-grid;
    place-items: center;
    padding: 0.875rem 1.5rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
    text-decoration: none;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform var(--dur-fast) var(--ease-out-snappy),
      box-shadow var(--dur-fast) var(--ease-out-soft),
      background-color var(--dur-fast) var(--ease-out-soft),
      border-color var(--dur-fast) var(--ease-out-soft),
      color var(--dur-fast) var(--ease-out-soft);
  }

  .btn__face {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .btn__face svg {
    inline-size: 0.85em;
    block-size: 0.85em;
  }

  .btn--solid {
    background-color: var(--accent);
    color: var(--accent-on);
    box-shadow: var(--shadow-md);
  }
  .btn--solid:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: var(--shadow-lg);
    background-color: color-mix(in oklab, var(--accent) 92%, white);
  }
  .btn--solid:active {
    transform: translateY(1px) scale(0.97);
    box-shadow: var(--shadow-pressed);
    transition-duration: 60ms;
  }
  .btn--solid:focus-visible {
    outline: none;
    box-shadow: var(--shadow-md), var(--halo-focus);
  }

  .btn--ghost {
    background-color: transparent;
    color: var(--ink);
    border: 1px solid var(--border-strong);
  }
  .btn--ghost:hover {
    transform: translateY(-2px);
    border-color: var(--ink-muted);
    color: var(--ink-strong);
    background-color: var(--surface);
  }
  .btn--ghost:active {
    transform: translateY(1px) scale(0.98);
    transition-duration: 60ms;
  }
  .btn--ghost:focus-visible {
    outline: none;
    box-shadow: var(--halo-focus);
  }

  /* ─── 1 · Hero ─── */
  .hero {
    padding-block: var(--rhythm-loose) var(--rhythm);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-2xl);
    grid-template-columns: 1fr;
    align-items: center;
  }

  @media (min-width: 60rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: var(--space-3xl);
    }
  }

  .hero__eyebrow {
    margin-block-end: var(--space-md);
  }

  .hero__title {
    margin-block-end: var(--space-md);
  }

  .hero__lede {
    font-size: var(--text-lg);
    color: var(--ink);
    max-inline-size: var(--measure);
    line-height: var(--leading-snug);
    margin-block-end: var(--space-md);
  }

  .hero__manifesto {
    color: var(--ink-muted);
    max-inline-size: var(--measure);
    line-height: var(--leading-relaxed);
    margin-block-end: var(--space-lg);
  }

  .hero__manifesto em {
    color: var(--accent-ink);
    font-style: normal;
    font-weight: var(--weight-medium);
  }

  .hero__cta {
    --cluster-gap: var(--space-sm);
  }

  /* ─── Specimen vivo ─── */
  .specimen {
    will-change: transform;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background-color: var(--surface-raised);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    justify-self: stretch;
  }

  .specimen__bar {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border-block-end: 1px solid var(--border);
    background-color: var(--surface);
  }

  .specimen__dots {
    display: inline-flex;
    gap: 0.375rem;
  }
  .specimen__dots i {
    inline-size: 0.6rem;
    block-size: 0.6rem;
    border-radius: 50%;
    background-color: var(--border-strong);
  }

  .specimen__label {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--ink-subtle);
    letter-spacing: var(--tracking-wide);
    text-transform: lowercase;
  }

  .specimen__stage {
    display: grid;
    place-items: center;
    gap: var(--space-md);
    padding: var(--space-2xl) var(--space-lg);
    text-align: center;
    /* punto di luce caldo, appena percepibile — niente piattume */
    background-image: radial-gradient(
       circle at 50% 38%,
      color-mix(in oklab, var(--accent) 9%, transparent),
      transparent 62%
    );
  }

  .specimen__caption {
    max-inline-size: 28ch;
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--ink-muted);
  }

  .specimen__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    padding: var(--space-sm) var(--space-md);
    border-block-start: 1px solid var(--border);
    background-color: var(--surface);
  }
  .specimen__chip {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--ink-muted);
    letter-spacing: var(--tracking-wide);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-xs);
    background-color: var(--surface-sunken);
    border: 1px solid var(--border);
  }

  /* Soft-press reale dentro lo specimen */
  .soft-press {
    position: relative;
    display: inline-grid;
    padding: 0.875rem 1.75rem;
    border-radius: var(--radius-pill);
    border: 0;
    background-color: var(--accent);
    color: var(--accent-on);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
    box-shadow: var(--shadow-md);
    transition:
      transform var(--dur-fast) var(--ease-out-snappy),
      box-shadow var(--dur-fast) var(--ease-out-soft),
      background-color var(--dur-fast) var(--ease-out-soft);
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .soft-press:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: var(--shadow-lg);
    background-color: color-mix(in oklab, var(--accent) 92%, white);
  }
  .soft-press:active {
    transform: translateY(1px) scale(0.97);
    box-shadow: var(--shadow-pressed);
    transition-duration: 60ms;
  }
  .soft-press:focus-visible {
    outline: none;
    box-shadow: var(--shadow-md), var(--halo-focus);
  }
  .soft-press__face {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  /* ─── 2 · Statement ─── */
  .statement {
    padding-block: var(--rhythm);
    border-block: 1px solid var(--border);
    background-color: var(--surface);
  }

  .statement__text {
    max-inline-size: 24ch;
    margin-inline: auto;
    text-align: center;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-medium);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--ink-strong);
    text-wrap: balance;
  }

  .statement__text em {
    font-style: italic;
    color: var(--accent-ink);
  }

  /* ─── 3 · Principi (bento asimmetrico) ─── */
  .principles {
    padding-block: var(--rhythm-loose);
  }

  .principles__head {
    margin-block-end: var(--space-xl);
  }
  .principles__head .eyebrow {
    margin-block-end: var(--space-2xs);
  }
  .principles__title {
    font-size: var(--text-xl);
    max-inline-size: 28ch;
    color: var(--ink-strong);
  }

  .principles__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: 1fr;
  }

  @media (min-width: 48rem) {
    .principles__grid {
      grid-template-columns: repeat(6, 1fr);
    }
    /* Ritmo asimmetrico: la prima cella è larga, le altre tre strette.
       4 celle, 4 contenuti — nessuna cella vuota. */
    .pcell--1 { grid-column: span 3; }
    .pcell--2 { grid-column: span 3; }
    .pcell--3 { grid-column: span 3; }
    .pcell--4 { grid-column: span 3; }
  }

  @media (min-width: 64rem) {
    .pcell--1 { grid-column: span 3; grid-row: span 2; }
    .pcell--2 { grid-column: span 3; }
    .pcell--3 { grid-column: span 3; }
    .pcell--4 { grid-column: span 6; }
  }

  .pcell {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
    padding: var(--space-lg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background-color: var(--surface-raised);
    transition:
      border-color var(--dur-normal) var(--ease-out-soft),
      background-color var(--dur-normal) var(--ease-out-soft);
  }
  .pcell:hover {
    border-color: var(--border-strong);
  }

  /* La cella di apertura porta l'accento: tinta soft, non un blocco pieno. */
  .pcell--1 {
    background-color: var(--accent-soft);
    border-color: color-mix(in oklab, var(--accent) 24%, var(--border));
  }
  .pcell--1 .pcell__num { color: var(--accent-ink); }
  .pcell--1 .pcell__title { color: var(--accent-ink); }

  .pcell__num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-subtle);
    letter-spacing: var(--tracking-wide);
  }
  .pcell__title {
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    color: var(--ink-strong);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
  }
  .pcell__body {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: var(--leading-relaxed);
    max-inline-size: 42ch;
  }

  /* ─── 4 · Capitoli ─── */
  .chapters {
    padding-block: var(--rhythm) var(--rhythm-loose);
    border-block-start: 1px solid var(--border);
  }

  .chapters__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    margin-block-end: var(--space-xl);
    padding-block-end: var(--space-md);
    border-block-end: 1px solid var(--border);
  }

  .chapters__title {
    font-size: var(--text-md);
    color: var(--ink-muted);
    font-weight: var(--weight-medium);
  }

  .chapters__hint {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2xs);
    font-size: var(--text-xs);
    color: var(--ink-subtle);
  }

  .chapters__count {
    color: var(--ink);
    font-weight: var(--weight-medium);
  }

  .chapters__grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
    grid-auto-rows: 1fr;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ─── 6 · Colophon ─── */
  .colophon {
    padding-block: var(--rhythm-loose);
    border-block-start: 1px solid var(--border);
    background-color: var(--surface);
  }

  .colophon__inner {
    max-inline-size: var(--max-prose);
    text-align: center;
  }

  .colophon__title {
    font-size: var(--text-xl);
    color: var(--ink-strong);
    margin-block-end: var(--space-lg);
  }

  .colophon__list {
    list-style: none;
    margin: 0 0 var(--space-xl);
    padding: 0;
    border-block-start: 1px solid var(--border);
  }
  .colophon__item {
    padding-block: var(--space-md);
    border-block-end: 1px solid var(--border);
    font-size: var(--text-md);
    color: var(--ink);
    line-height: var(--leading-snug);
  }

  .colophon__stack {
